        "# EXPERIMENT 7: PERCEPTRON AND FORWARD PROPAGATION\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# ==========================================================\n",
        "# PART 1: ACTIVATION FUNCTIONS\n",
        "# ==========================================================\n",
        "\n",
        "def step_activation(x):\n",
        "    return np.where(x >= 0, 1, 0)\n",
        "\n",
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-np.clip(x, -500, 500)))\n",
        "\n",
        "def relu(x):\n",
        "    return np.maximum(0, x)\n",
        "\n",
        "# ==========================================================\n",
        "# PART 2: GENERATE LOAN APPROVAL DATA\n",
        "# ==========================================================\n",
        "\n",
        "n_samples = 100\n",
        "\n",
        "credit_score = np.random.uniform(0, 1, n_samples)\n",
        "debt_ratio = np.random.uniform(0, 1, n_samples)\n",
        "\n",
        "X = np.column_stack((credit_score, debt_ratio))\n",
        "\n",
        "# Linear decision rule with noise\n",
        "y = (\n",
        "    0.8*credit_score\n",
        "    - 0.7*debt_ratio\n",
        "    + np.random.normal(0, 0.08, n_samples)\n",
        "    > 0.15\n",
        ").astype(int)\n",
        "\n",
        "# ==========================================================\n",
        "# PART 3: PERCEPTRON IMPLEMENTATION\n",
        "# ==========================================================\n",
        "\n",
        "class Perceptron:\n",
        "\n",
        "    def __init__(self, learning_rate=0.1, epochs=50):\n",
        "        self.lr = learning_rate\n",
        "        self.epochs = epochs\n",
        "        self.weights = np.zeros(2)\n",
        "        self.bias = 0\n",
        "        self.errors = []\n",
        "\n",
        "    def predict(self, X):\n",
        "        linear_output = np.dot(X, self.weights) + self.bias\n",
        "        return step_activation(linear_output)\n",
        "\n",
        "    def fit(self, X, y):\n",
        "\n",
        "        for epoch in range(self.epochs):\n",
        "\n",
        "            total_errors = 0\n",
        "\n",
        "            for i in range(len(X)):\n",
        "\n",
        "                prediction = self.predict(X[i])\n",
        "                error = y[i] - prediction\n",
        "\n",
        "                # Perceptron learning rule\n",
        "                self.weights += self.lr * error * X[i]\n",
        "                self.bias += self.lr * error\n",
        "\n",
        "                if error != 0:\n",
        "                    total_errors += 1\n",
        "\n",
        "            self.errors.append(total_errors)\n",
        "\n",
        "            print(f\"Epoch {epoch+1:2d}: Errors = {total_errors}\")\n",
        "\n",
        "            if total_errors == 0:\n",
        "                print(\"Converged successfully!\")\n",
        "                break\n",
        "\n",
        "# ==========================================================\n",
        "# PART 4: TRAIN PERCEPTRON\n",
        "# ==========================================================\n",
        "\n",
        "model = Perceptron(learning_rate=0.1, epochs=50)\n",
        "\n",
        "model.fit(X, y)\n",
        "\n",
        "predictions = model.predict(X)\n",
        "accuracy = np.mean(predictions == y) * 100\n",
        "\n",
        "print(\"\\nFinal Weights:\", model.weights)\n",
        "print(\"Final Bias:\", model.bias)\n",
        "print(\"Training Accuracy:\", round(accuracy, 2), \"%\")\n",
        "\n",
        "# ==========================================================\n",
        "# PART 5: PLOT DATA AND DECISION BOUNDARY\n",
        "# ==========================================================\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "plt.scatter(X[y==0, 0], X[y==0, 1],\n",
        "            label=\"Rejected\", marker=\"x\")\n",
        "\n",
        "plt.scatter(X[y==1, 0], X[y==1, 1],\n",
        "            label=\"Approved\", marker=\"o\")\n",
        "\n",
        "# Decision boundary: w1*x1 + w2*x2 + b = 0\n",
        "x_line = np.linspace(0, 1, 100)\n",
        "\n",
        "if abs(model.weights[1]) > 1e-8:\n",
        "    y_line = (\n",
        "        -(model.weights[0]*x_line + model.bias)\n",
        "        / model.weights[1]\n",
        "    )\n",
        "    plt.plot(x_line, y_line, label=\"Decision Boundary\")\n",
        "\n",
        "plt.xlabel(\"Credit Score (Normalized)\")\n",
        "plt.ylabel(\"Debt Ratio (Normalized)\")\n",
        "plt.title(\"Perceptron Loan Approval Decision Boundary\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# ==========================================================\n",
        "# PART 6: PLOT TRAINING ERRORS\n",
        "# ==========================================================\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(model.errors, marker=\"o\")\n",
        "\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Number of Misclassified Samples\")\n",
        "plt.title(\"Perceptron Learning Progress\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# ==========================================================\n",
        "# PART 7: XOR DATASET\n",
        "# ==========================================================\n",
        "\n",
        "X_xor = np.array([\n",
        "    [0, 0],\n",
        "    [0, 1],\n",
        "    [1, 0],\n",
        "    [1, 1]\n",
        "])\n",
        "\n",
        "y_xor = np.array([0, 1, 1, 0])\n",
        "\n",
        "xor_model = Perceptron(learning_rate=0.1, epochs=30)\n",
        "\n",
        "print(\"\\nTraining Perceptron on XOR Dataset\")\n",
        "xor_model.fit(X_xor, y_xor)\n",
        "\n",
        "xor_predictions = xor_model.predict(X_xor)\n",
        "xor_accuracy = np.mean(xor_predictions == y_xor) * 100\n",
        "\n",
        "print(\"\\nXOR Actual Labels:\", y_xor)\n",
        "print(\"XOR Predicted Labels:\", xor_predictions)\n",
        "print(\"XOR Accuracy:\", xor_accuracy, \"%\")\n",
        "\n",
        "# ==========================================================\n",
        "# PART 8: VISUALIZE XOR\n",
        "# ==========================================================\n",
        "\n",
        "plt.figure(figsize=(7, 5))\n",
        "\n",
        "for i in range(len(X_xor)):\n",
        "    color = \"blue\" if y_xor[i] == 0 else \"red\"\n",
        "    plt.scatter(X_xor[i, 0], X_xor[i, 1],\n",
        "               color=color, s=150)\n",
        "\n",
        "    plt.text(X_xor[i, 0]+0.05,\n",
        "             X_xor[i, 1]+0.05,\n",
        "             f\"Class {y_xor[i]}\")\n",
        "\n",
        "plt.xlabel(\"Input X1\")\n",
        "plt.ylabel(\"Input X2\")\n",
        "plt.title(\"XOR Dataset - Non-Linear Classification\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# ==========================================================\n",
        "# PART 9: COMPARE ACTIVATION FUNCTIONS\n",
        "# ==========================================================\n",
        "\n",
        "inputs = np.linspace(-5, 5, 200)\n",
        "\n",
        "step_values = step_activation(inputs)\n",
        "sigmoid_values = sigmoid(inputs)\n",
        "relu_values = relu(inputs)\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "plt.plot(inputs, step_values, label=\"Step\")\n",
        "plt.plot(inputs, sigmoid_values, label=\"Sigmoid\")\n",
        "plt.plot(inputs, relu_values, label=\"ReLU\")\n",
        "\n",
        "plt.xlabel(\"Input\")\n",
        "plt.ylabel(\"Output\")\n",
        "plt.title(\"Comparison of Activation Functions\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# ==========================================================\n",
        "# PART 10: FORWARD PROPAGATION EXAMPLE\n",
        "# ==========================================================\n",
        "\n",
        "sample_input = np.array([0.8, 0.3])\n",
        "\n",
        "weighted_sum = np.dot(sample_input, model.weights) + model.bias\n",
        "output = step_activation(weighted_sum)\n",
        "\n",
        "print(\"\\nFORWARD PROPAGATION EXAMPLE\")\n",
        "print(\"Input:\", sample_input)\n",
        "print(\"Weighted Sum:\", round(weighted_sum, 4))\n",
        "print(\"Bias:\", round(model.bias, 4))\n",
        "print(\"Perceptron Output:\", output)\n",
        "\n",
        "print(\"\\nExperiment 7 Completed Successfully!\")"
      ]
    }
