        "# EXPERIMENT 23: BAYESIAN NETWORK CONSTRUCTION AND VISUALIZATION\n",
        "# Medical Diagnosis Bayesian Network\n",
        "\n",
        "!pip -q install pgmpy\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import networkx as nx\n",
        "\n",
        "from pgmpy.factors.discrete import TabularCPD\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. IMPORT PGMPY MODEL CLASS (VERSION COMPATIBILITY)\n",
        "# --------------------------------------------------\n",
        "try:\n",
        "    from pgmpy.models import DiscreteBayesianNetwork as BayesianModel\n",
        "except ImportError:\n",
        "    from pgmpy.models import BayesianNetwork as BayesianModel\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. DEFINE BAYESIAN NETWORK STRUCTURE\n",
        "# --------------------------------------------------\n",
        "edges = [\n",
        "    (\"Smoking\", \"LungDisease\"),\n",
        "    (\"Pollution\", \"LungDisease\"),\n",
        "    (\"LungDisease\", \"Cough\"),\n",
        "    (\"LungDisease\", \"Xray\"),\n",
        "    (\"LungDisease\", \"Fatigue\")\n",
        "]\n",
        "\n",
        "model = BayesianModel(edges)\n",
        "\n",
        "print(\"Bayesian Network Structure Created\")\n",
        "print(\"Nodes:\", list(model.nodes()))\n",
        "print(\"Edges:\", list(model.edges()))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. DEFINE CONDITIONAL PROBABILITY DISTRIBUTIONS\n",
        "# State 0 = No / Negative / Low\n",
        "# State 1 = Yes / Positive / High\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Smoking\n",
        "cpd_smoking = TabularCPD(\n",
        "    variable=\"Smoking\",\n",
        "    variable_card=2,\n",
        "    values=[[0.70], [0.30]]\n",
        ")\n",
        "\n",
        "# Pollution\n",
        "cpd_pollution = TabularCPD(\n",
        "    variable=\"Pollution\",\n",
        "    variable_card=2,\n",
        "    values=[[0.80], [0.20]]\n",
        ")\n",
        "\n",
        "# Lung Disease given Smoking and Pollution\n",
        "cpd_lung = TabularCPD(\n",
        "    variable=\"LungDisease\",\n",
        "    variable_card=2,\n",
        "    values=[\n",
        "        [0.99, 0.95, 0.97, 0.90],\n",
        "        [0.01, 0.05, 0.03, 0.10]\n",
        "    ],\n",
        "    evidence=[\"Smoking\", \"Pollution\"],\n",
        "    evidence_card=[2, 2]\n",
        ")\n",
        "\n",
        "# Cough given Lung Disease\n",
        "cpd_cough = TabularCPD(\n",
        "    variable=\"Cough\",\n",
        "    variable_card=2,\n",
        "    values=[\n",
        "        [0.80, 0.30],\n",
        "        [0.20, 0.70]\n",
        "    ],\n",
        "    evidence=[\"LungDisease\"],\n",
        "    evidence_card=[2]\n",
        ")\n",
        "\n",
        "# X-ray given Lung Disease\n",
        "cpd_xray = TabularCPD(\n",
        "    variable=\"Xray\",\n",
        "    variable_card=2,\n",
        "    values=[\n",
        "        [0.90, 0.20],\n",
        "        [0.10, 0.80]\n",
        "    ],\n",
        "    evidence=[\"LungDisease\"],\n",
        "    evidence_card=[2]\n",
        ")\n",
        "\n",
        "# Fatigue given Lung Disease\n",
        "cpd_fatigue = TabularCPD(\n",
        "    variable=\"Fatigue\",\n",
        "    variable_card=2,\n",
        "    values=[\n",
        "        [0.70, 0.25],\n",
        "        [0.30, 0.75]\n",
        "    ],\n",
        "    evidence=[\"LungDisease\"],\n",
        "    evidence_card=[2]\n",
        ")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. ADD CPDs TO THE MODEL\n",
        "# --------------------------------------------------\n",
        "model.add_cpds(\n",
        "    cpd_smoking,\n",
        "    cpd_pollution,\n",
        "    cpd_lung,\n",
        "    cpd_cough,\n",
        "    cpd_xray,\n",
        "    cpd_fatigue\n",
        ")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. VALIDATE BAYESIAN NETWORK\n",
        "# --------------------------------------------------\n",
        "print(\"\\n===== MODEL VALIDATION =====\")\n",
        "\n",
        "if model.check_model():\n",
        "    print(\"Model is valid!\")\n",
        "    print(\"All CPDs are consistent with the network structure.\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. DISPLAY CONDITIONAL PROBABILITY TABLES\n",
        "# --------------------------------------------------\n",
        "print(\"\\n===== CONDITIONAL PROBABILITY DISTRIBUTIONS =====\")\n",
        "\n",
        "for cpd in model.get_cpds():\n",
        "    print(\"\\n\", cpd)\n",
        "    print(cpd)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. VISUALIZE NETWORK USING NETWORKX\n",
        "# --------------------------------------------------\n",
        "G = nx.DiGraph()\n",
        "G.add_edges_from(edges)\n",
        "\n",
        "pos = {\n",
        "    \"Smoking\": (0, 2),\n",
        "    \"Pollution\": (2, 2),\n",
        "    \"LungDisease\": (1, 1),\n",
        "    \"Cough\": (0, 0),\n",
        "    \"Xray\": (1, 0),\n",
        "    \"Fatigue\": (2, 0)\n",
        "}\n",
        "\n",
        "plt.figure(figsize=(12, 8))\n",
        "\n",
        "nx.draw_networkx_nodes(\n",
        "    G, pos,\n",
        "    node_size=3000\n",
        ")\n",
        "\n",
        "nx.draw_networkx_edges(\n",
        "    G, pos,\n",
        "    arrows=True,\n",
        "    arrowsize=25,\n",
        "    width=2\n",
        ")\n",
        "\n",
        "nx.draw_networkx_labels(\n",
        "    G, pos,\n",
        "    font_size=10,\n",
        "    font_weight=\"bold\"\n",
        ")\n",
        "\n",
        "plt.title(\"Medical Diagnosis Bayesian Network\", fontsize=15)\n",
        "plt.axis(\"off\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. CONDITIONAL INDEPENDENCIES\n",
        "# --------------------------------------------------\n",
        "print(\"\\n===== CONDITIONAL INDEPENDENCIES =====\")\n",
        "\n",
        "independencies = model.get_independencies()\n",
        "print(independencies)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. ACTIVE TRAILS\n",
        "# --------------------------------------------------\n",
        "print(\"\\n===== ACTIVE TRAILS =====\")\n",
        "\n",
        "# Active trails from Smoking without evidence\n",
        "active_no_evidence = model.active_trail_nodes(\n",
        "    \"Smoking\",\n",
        "    observed=[]\n",
        ")\n",
        "\n",
        "print(\"\\nActive trails from Smoking (no evidence):\")\n",
        "print(active_no_evidence)\n",
        "\n",
        "# Active trails from Smoking when LungDisease is observed\n",
        "active_with_evidence = model.active_trail_nodes(\n",
        "    \"Smoking\",\n",
        "    observed=[\"LungDisease\"]\n",
        ")\n",
        "\n",
        "print(\"\\nActive trails from Smoking (LungDisease observed):\")\n",
        "print(active_with_evidence)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 10. SUMMARY TABLE\n",
        "# --------------------------------------------------\n",
        "summary = pd.DataFrame({\n",
        "    \"Node\": list(model.nodes()),\n",
        "    \"Type\": [\n",
        "        \"Risk Factor\",\n",
        "        \"Risk Factor\",\n",
        "        \"Disease\",\n",
        "        \"Symptom\",\n",
        "        \"Diagnostic Test\",\n",
        "        \"Symptom\"\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"\\n===== NETWORK NODE SUMMARY =====\")\n",
        "print(summary)\n",
        "\n",
        "print(\"\\nEXPERIMENT 23 COMPLETED SUCCESSFULLY\")"
      ]
    }
