        "# EXPERIMENT 6: GD, SGD, MOMENTUM AND ADAM COMPARISON\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import tensorflow as tf\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "\n",
        "# ==========================================================\n",
        "# PART 1: DEFINE SIMPLE LOSS SURFACE\n",
        "# ==========================================================\n",
        "\n",
        "def loss_function(w):\n",
        "    return w[0]**2 + 10*w[1]**2\n",
        "\n",
        "def gradient(w):\n",
        "    return np.array([2*w[0], 20*w[1]])\n",
        "\n",
        "# Starting point\n",
        "initial_point = np.array([4.0, 4.0])\n",
        "epochs = 100\n",
        "learning_rate = 0.05\n",
        "\n",
        "# ==========================================================\n",
        "# PART 2: BATCH GRADIENT DESCENT\n",
        "# ==========================================================\n",
        "\n",
        "def batch_gd():\n",
        "    w = initial_point.copy()\n",
        "    path = [w.copy()]\n",
        "\n",
        "    for i in range(epochs):\n",
        "        w = w - learning_rate * gradient(w)\n",
        "        path.append(w.copy())\n",
        "\n",
        "    return np.array(path)\n",
        "\n",
        "# ==========================================================\n",
        "# PART 3: STOCHASTIC GRADIENT DESCENT\n",
        "# ==========================================================\n",
        "\n",
        "def sgd():\n",
        "    w = initial_point.copy()\n",
        "    path = [w.copy()]\n",
        "\n",
        "    for i in range(epochs):\n",
        "        # Add small random noise to simulate sample-wise gradients\n",
        "        grad = gradient(w) + np.random.normal(0, 0.5, 2)\n",
        "        w = w - learning_rate * grad\n",
        "        path.append(w.copy())\n",
        "\n",
        "    return np.array(path)\n",
        "\n",
        "# ==========================================================\n",
        "# PART 4: MOMENTUM\n",
        "# ==========================================================\n",
        "\n",
        "def momentum_gd():\n",
        "    w = initial_point.copy()\n",
        "    velocity = np.zeros(2)\n",
        "    beta = 0.9\n",
        "    path = [w.copy()]\n",
        "\n",
        "    for i in range(epochs):\n",
        "        grad = gradient(w)\n",
        "        velocity = beta * velocity + learning_rate * grad\n",
        "        w = w - velocity\n",
        "        path.append(w.copy())\n",
        "\n",
        "    return np.array(path)\n",
        "\n",
        "# ==========================================================\n",
        "# PART 5: ADAM OPTIMIZER\n",
        "# ==========================================================\n",
        "\n",
        "def adam_optimizer():\n",
        "    w = initial_point.copy()\n",
        "    m = np.zeros(2)\n",
        "    v = np.zeros(2)\n",
        "\n",
        "    beta1 = 0.9\n",
        "    beta2 = 0.999\n",
        "    epsilon = 1e-8\n",
        "    lr = 0.08\n",
        "\n",
        "    path = [w.copy()]\n",
        "\n",
        "    for t in range(1, epochs + 1):\n",
        "        g = gradient(w)\n",
        "\n",
        "        m = beta1 * m + (1-beta1)*g\n",
        "        v = beta2 * v + (1-beta2)*(g**2)\n",
        "\n",
        "        m_hat = m / (1-beta1**t)\n",
        "        v_hat = v / (1-beta2**t)\n",
        "\n",
        "        w = w - lr*m_hat/(np.sqrt(v_hat)+epsilon)\n",
        "        path.append(w.copy())\n",
        "\n",
        "    return np.array(path)\n",
        "\n",
        "# ==========================================================\n",
        "# PART 6: COMPARE OPTIMIZER PATHS\n",
        "# ==========================================================\n",
        "\n",
        "paths = {\n",
        "    \"Batch GD\": batch_gd(),\n",
        "    \"SGD\": sgd(),\n",
        "    \"Momentum\": momentum_gd(),\n",
        "    \"Adam\": adam_optimizer()\n",
        "}\n",
        "\n",
        "# Loss curves\n",
        "plt.figure(figsize=(10,6))\n",
        "\n",
        "for name, path in paths.items():\n",
        "    losses = [loss_function(w) for w in path]\n",
        "    plt.plot(losses, label=name)\n",
        "\n",
        "plt.yscale(\"log\")\n",
        "plt.xlabel(\"Iterations\")\n",
        "plt.ylabel(\"Loss (Log Scale)\")\n",
        "plt.title(\"Optimizer Convergence Comparison\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# ==========================================================\n",
        "# PART 7: PLOT OPTIMIZER PATHS ON CONTOUR\n",
        "# ==========================================================\n",
        "\n",
        "x = np.linspace(-5, 5, 200)\n",
        "y = np.linspace(-5, 5, 200)\n",
        "X, Y = np.meshgrid(x, y)\n",
        "Z = X**2 + 10*Y**2\n",
        "\n",
        "plt.figure(figsize=(10,7))\n",
        "\n",
        "plt.contour(X, Y, Z, levels=30)\n",
        "for name, path in paths.items():\n",
        "    plt.plot(path[:,0], path[:,1], marker=\"o\",\n",
        "             markersize=2, label=name)\n",
        "\n",
        "plt.xlabel(\"Weight 1\")\n",
        "plt.ylabel(\"Weight 2\")\n",
        "plt.title(\"Optimizer Paths on Loss Contour\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# ==========================================================\n",
        "# PART 8: LEARNING RATE COMPARISON\n",
        "# ==========================================================\n",
        "\n",
        "learning_rates = [0.01, 0.05, 0.15]\n",
        "plt.figure(figsize=(10,6))\n",
        "\n",
        "for lr in learning_rates:\n",
        "    w = initial_point.copy()\n",
        "    loss_history = []\n",
        "\n",
        "    for i in range(50):\n",
        "        loss_history.append(loss_function(w))\n",
        "        w = w - lr*gradient(w)\n",
        "\n",
        "    loss_history = np.array(loss_history)\n",
        "\n",
        "    # Avoid log-scale issues if values become extremely large\n",
        "    loss_history = np.clip(loss_history, 1e-10, 1e100)\n",
        "\n",
        "    plt.plot(loss_history, label=f\"Learning Rate = {lr}\")\n",
        "\n",
        "plt.yscale(\"log\")\n",
        "plt.xlabel(\"Iterations\")\n",
        "plt.ylabel(\"Loss (Log Scale)\")\n",
        "plt.title(\"Learning Rate Effect on Gradient Descent\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# ==========================================================\n",
        "# PART 9: CREATE DELIVERY-TIME DATASET\n",
        "# ==========================================================\n",
        "\n",
        "n = 1000\n",
        "\n",
        "distance = np.random.uniform(1, 50, n)\n",
        "traffic = np.random.uniform(1, 10, n)\n",
        "weight = np.random.uniform(1, 20, n)\n",
        "time_of_day = np.random.uniform(0, 24, n)\n",
        "\n",
        "# Delivery time target (minutes)\n",
        "delivery_time = (\n",
        "    10\n",
        "    + 1.5*distance\n",
        "    + 2.5*traffic\n",
        "    + 0.3*weight\n",
        "    + 0.5*np.sin(time_of_day)\n",
        "    + np.random.normal(0, 3, n)\n",
        ")\n",
        "\n",
        "X_data = np.column_stack([\n",
        "    distance, traffic, weight, time_of_day\n",
        "])\n",
        "\n",
        "y_data = delivery_time\n",
        "\n",
        "# Train-test split\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X_data, y_data, test_size=0.2, random_state=42\n",
        ")\n",
        "\n",
        "# Normalize inputs\n",
        "scaler = StandardScaler()\n",
        "X_train = scaler.fit_transform(X_train)\n",
        "X_test = scaler.transform(X_test)\n",
        "\n",
        "# ==========================================================\n",
        "# PART 10: KERAS REGRESSION MODEL\n",
        "# ==========================================================\n",
        "\n",
        "def build_model(optimizer):\n",
        "    model = tf.keras.Sequential([\n",
        "        tf.keras.layers.Input(shape=(4,)),\n",
        "        tf.keras.layers.Dense(32, activation=\"relu\"),\n",
        "        tf.keras.layers.Dense(16, activation=\"relu\"),\n",
        "        tf.keras.layers.Dense(1)\n",
        "    ])\n",
        "\n",
        "    model.compile(\n",
        "        optimizer=optimizer,\n",
        "        loss=\"mse\",\n",
        "        metrics=[\"mae\"]\n",
        "    )\n",
        "\n",
        "    return model\n",
        "\n",
        "# Define optimizers\n",
        "optimizer_dict = {\n",
        "    \"SGD\": tf.keras.optimizers.SGD(learning_rate=0.01),\n",
        "    \"SGD + Momentum\": tf.keras.optimizers.SGD(\n",
        "        learning_rate=0.01, momentum=0.9\n",
        "    ),\n",
        "    \"Adam\": tf.keras.optimizers.Adam(learning_rate=0.01)\n",
        "}\n",
        "\n",
        "# ==========================================================\n",
        "# PART 11: TRAIN AND COMPARE KERAS MODELS\n",
        "# ==========================================================\n",
        "\n",
        "histories = {}\n",
        "results = {}\n",
        "\n",
        "for name, optimizer in optimizer_dict.items():\n",
        "\n",
        "    print(\"\\nTraining:\", name)\n",
        "\n",
        "    model = build_model(optimizer)\n",
        "\n",
        "    history = model.fit(\n",
        "        X_train, y_train,\n",
        "        validation_data=(X_test, y_test),\n",
        "        epochs=50,\n",
        "        batch_size=32,\n",
        "        verbose=0\n",
        "    )\n",
        "\n",
        "    histories[name] = history\n",
        "\n",
        "    test_loss, test_mae = model.evaluate(\n",
        "        X_test, y_test, verbose=0\n",
        "    )\n",
        "\n",
        "    results[name] = (test_loss, test_mae)\n",
        "\n",
        "    print(\"Test MSE:\", round(test_loss, 3))\n",
        "    print(\"Test MAE:\", round(test_mae, 3))\n",
        "\n",
        "# ==========================================================\n",
        "# PART 12: PLOT KERAS TRAINING LOSS\n",
        "# ==========================================================\n",
        "\n",
        "plt.figure(figsize=(10,6))\n",
        "\n",
        "for name, history in histories.items():\n",
        "    plt.plot(history.history[\"loss\"], label=name)\n",
        "\n",
        "plt.xlabel(\"Epochs\")\n",
        "plt.ylabel(\"Training Loss (MSE)\")\n",
        "plt.title(\"Keras Optimizer Training Loss Comparison\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# ==========================================================\n",
        "# PART 13: PLOT VALIDATION LOSS\n",
        "# ==========================================================\n",
        "\n",
        "plt.figure(figsize=(10,6))\n",
        "\n",
        "for name, history in histories.items():\n",
        "    plt.plot(history.history[\"val_loss\"], label=name)\n",
        "\n",
        "plt.xlabel(\"Epochs\")\n",
        "plt.ylabel(\"Validation Loss (MSE)\")\n",
        "plt.title(\"Validation Loss Comparison\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# ==========================================================\n",
        "# PART 14: FINAL COMPARISON TABLE\n",
        "# ==========================================================\n",
        "\n",
        "print(\"\\nFINAL OPTIMIZER COMPARISON\")\n",
        "print(\"=\"*55)\n",
        "\n",
        "for name, (mse, mae) in results.items():\n",
        "    print(f\"{name:18s} | MSE = {mse:.4f} | MAE = {mae:.4f}\")\n",
        "\n",
        "print(\"\\nExperiment 6 Completed Successfully!\")"
      ]
    }
