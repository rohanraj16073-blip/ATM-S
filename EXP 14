        "# EXPERIMENT 14: UNFOLDED RNN ARCHITECTURE VISUALIZATION\n",
        "\n",
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "import networkx as nx\n",
        "\n",
        "from tensorflow.keras.models import Model\n",
        "from tensorflow.keras.layers import Input, SimpleRNN, Dense\n",
        "\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. INPUT SEQUENCE (5 WORDS)\n",
        "# --------------------------------------------------\n",
        "\n",
        "words = [\"Deep\", \"Learning\", \"Models\", \"Process\", \"Sequences\"]\n",
        "\n",
        "# Each word represented by a 4-dimensional vector\n",
        "X = np.random.rand(1, 5, 4).astype(np.float32)\n",
        "\n",
        "print(\"Input sentence:\", words)\n",
        "print(\"Input shape:\", X.shape)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. BUILD SIMPLE RNN\n",
        "# --------------------------------------------------\n",
        "\n",
        "input_layer = Input(shape=(5, 4))\n",
        "\n",
        "rnn_layer = SimpleRNN(\n",
        "    3,\n",
        "    activation=\"tanh\",\n",
        "    return_sequences=True,\n",
        "    return_state=True,\n",
        "    name=\"SimpleRNN\"\n",
        ")\n",
        "\n",
        "sequence_output, final_state = rnn_layer(input_layer)\n",
        "\n",
        "dense_layer = Dense(2, activation=\"softmax\", name=\"OutputLayer\")\n",
        "output = dense_layer(sequence_output)\n",
        "\n",
        "model = Model(input_layer, [output, sequence_output, final_state])\n",
        "\n",
        "model.summary()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. EXTRACT RNN WEIGHTS\n",
        "# --------------------------------------------------\n",
        "\n",
        "Wx, Wh, bh = rnn_layer.get_weights()\n",
        "\n",
        "Wy, by = dense_layer.get_weights()\n",
        "\n",
        "print(\"\\nInput Weight Matrix Wx:\")\n",
        "print(Wx)\n",
        "\n",
        "print(\"\\nRecurrent Weight Matrix Wh:\")\n",
        "print(Wh)\n",
        "\n",
        "print(\"\\nHidden Bias:\")\n",
        "print(bh)\n",
        "\n",
        "print(\"\\nOutput Weight Matrix Wy:\")\n",
        "print(Wy)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. MANUAL HIDDEN STATE CALCULATION\n",
        "# --------------------------------------------------\n",
        "\n",
        "h_prev = np.zeros((3,), dtype=np.float32)\n",
        "\n",
        "manual_states = []\n",
        "manual_outputs = []\n",
        "\n",
        "for t in range(5):\n",
        "\n",
        "    x_t = X[0, t, :]\n",
        "\n",
        "    # Hidden state calculation\n",
        "    h_t = np.tanh(\n",
        "        np.dot(x_t, Wx) +\n",
        "        np.dot(h_prev, Wh) +\n",
        "        bh\n",
        "    )\n",
        "\n",
        "    # Output calculation\n",
        "    z_t = np.dot(h_t, Wy) + by\n",
        "\n",
        "    # Softmax\n",
        "    exp_z = np.exp(z_t - np.max(z_t))\n",
        "    y_t = exp_z / np.sum(exp_z)\n",
        "\n",
        "    manual_states.append(h_t.copy())\n",
        "    manual_outputs.append(y_t.copy())\n",
        "\n",
        "    h_prev = h_t\n",
        "\n",
        "manual_states = np.array(manual_states)\n",
        "manual_outputs = np.array(manual_outputs)\n",
        "\n",
        "print(\"\\n========== MANUAL HIDDEN STATES ==========\")\n",
        "\n",
        "for t in range(5):\n",
        "    print(f\"Hidden State h{t+1}:\")\n",
        "    print(np.round(manual_states[t], 4))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. COMPARE WITH KERAS OUTPUT\n",
        "# --------------------------------------------------\n",
        "\n",
        "keras_output, keras_states, keras_final = model.predict(X, verbose=0)\n",
        "\n",
        "print(\"\\n========== KERAS HIDDEN STATES ==========\")\n",
        "\n",
        "for t in range(5):\n",
        "    print(f\"Keras h{t+1}:\")\n",
        "    print(np.round(keras_states[0, t], 4))\n",
        "\n",
        "# Numerical verification\n",
        "difference = np.max(\n",
        "    np.abs(manual_states - keras_states[0])\n",
        ")\n",
        "\n",
        "print(\"\\nMaximum Difference:\", difference)\n",
        "\n",
        "if difference < 1e-5:\n",
        "    print(\"Manual calculation matches Keras!\")\n",
        "else:\n",
        "    print(\"Small numerical difference detected.\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. DRAW UNFOLDED RNN USING NETWORKX\n",
        "# --------------------------------------------------\n",
        "\n",
        "G = nx.DiGraph()\n",
        "\n",
        "pos = {}\n",
        "\n",
        "# Create input, hidden, output nodes\n",
        "for t in range(5):\n",
        "\n",
        "    input_node = f\"x{t+1}\"\n",
        "    hidden_node = f\"h{t+1}\"\n",
        "    output_node = f\"y{t+1}\"\n",
        "\n",
        "    G.add_node(input_node, category=\"input\")\n",
        "    G.add_node(hidden_node, category=\"hidden\")\n",
        "    G.add_node(output_node, category=\"output\")\n",
        "\n",
        "    pos[input_node] = (t, 2)\n",
        "    pos[hidden_node] = (t, 1)\n",
        "    pos[output_node] = (t, 0)\n",
        "\n",
        "    # Input to hidden\n",
        "    G.add_edge(input_node, hidden_node, label=\"Wxh\")\n",
        "\n",
        "    # Hidden to output\n",
        "    G.add_edge(hidden_node, output_node, label=\"Why\")\n",
        "\n",
        "    # Recurrent connection\n",
        "    if t > 0:\n",
        "        G.add_edge(f\"h{t}\", hidden_node, label=\"Whh\")\n",
        "\n",
        "# Draw network\n",
        "plt.figure(figsize=(14, 6))\n",
        "\n",
        "node_colors = []\n",
        "\n",
        "for node in G.nodes():\n",
        "    if node.startswith(\"x\"):\n",
        "        node_colors.append(\"skyblue\")\n",
        "    elif node.startswith(\"h\"):\n",
        "        node_colors.append(\"orange\")\n",
        "    else:\n",
        "        node_colors.append(\"lightgreen\")\n",
        "\n",
        "nx.draw(\n",
        "    G,\n",
        "    pos,\n",
        "    with_labels=True,\n",
        "    node_color=node_colors,\n",
        "    node_size=1800,\n",
        "    font_size=11,\n",
        "    arrows=True,\n",
        "    arrowsize=20\n",
        ")\n",
        "\n",
        "edge_labels = nx.get_edge_attributes(G, \"label\")\n",
        "\n",
        "nx.draw_networkx_edge_labels(\n",
        "    G,\n",
        "    pos,\n",
        "    edge_labels=edge_labels,\n",
        "    font_size=8\n",
        ")\n",
        "\n",
        "plt.title(\"RNN Unfolded Across Five Time Steps\")\n",
        "plt.xlabel(\"Time Steps\")\n",
        "plt.ylabel(\"Network Layers\")\n",
        "plt.grid(False)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. HIDDEN STATE VISUALIZATION\n",
        "# --------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "for i in range(3):\n",
        "    plt.plot(\n",
        "        range(1, 6),\n",
        "        manual_states[:, i],\n",
        "        marker=\"o\",\n",
        "        label=f\"Hidden Unit {i+1}\"\n",
        "    )\n",
        "\n",
        "plt.title(\"Hidden State Values Across Time Steps\")\n",
        "plt.xlabel(\"Time Step\")\n",
        "plt.ylabel(\"Hidden State Activation\")\n",
        "plt.xticks(range(1, 6))\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. INPUT AND OUTPUT SEQUENCE DISPLAY\n",
        "# --------------------------------------------------\n",
        "\n",
        "print(\"\\n========== SEQUENCE PROCESSING ==========\")\n",
        "\n",
        "for t in range(5):\n",
        "    print(\n",
        "        words[t],\n",
        "        \"-> Hidden State:\",\n",
        "        np.round(manual_states[t], 3),\n",
        "        \"-> Output:\",\n",
        "        np.round(manual_outputs[t], 3)\n",
        "    )\n",
        "\n",
        "print(\"\\nExperiment 14 Completed Successfully!\")"
      ]
