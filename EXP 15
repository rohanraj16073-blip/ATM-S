        "# EXPERIMENT 15: BPTT FLOW AND GRADIENT ANALYSIS\n",
        "# Tanh vs ReLU | Sequence Length 10, 50, 100\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import tensorflow as tf\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. GENERATE 3 YEARS OF SYNTHETIC STOCK DATA\n",
        "# --------------------------------------------------\n",
        "days = 3 * 365\n",
        "\n",
        "trend = np.linspace(100, 180, days)\n",
        "seasonal = 5 * np.sin(np.linspace(0, 20*np.pi, days))\n",
        "noise = np.random.normal(0, 2, days)\n",
        "\n",
        "prices = trend + seasonal + noise\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"Day\": np.arange(days),\n",
        "    \"Closing_Price\": prices\n",
        "})\n",
        "\n",
        "plt.figure(figsize=(12,4))\n",
        "plt.plot(df[\"Day\"], df[\"Closing_Price\"])\n",
        "plt.title(\"Synthetic Stock Closing Prices – 3 Years\")\n",
        "plt.xlabel(\"Days\")\n",
        "plt.ylabel(\"Closing Price\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. NORMALIZE DATA\n",
        "# --------------------------------------------------\n",
        "scaler = MinMaxScaler()\n",
        "scaled_prices = scaler.fit_transform(prices.reshape(-1,1))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. CREATE SEQUENCES\n",
        "# --------------------------------------------------\n",
        "def create_sequences(data, seq_length):\n",
        "    X, y = [], []\n",
        "    for i in range(len(data) - seq_length):\n",
        "        X.append(data[i:i+seq_length])\n",
        "        y.append(data[i+seq_length])\n",
        "    return np.array(X), np.array(y)\n",
        "\n",
        "sequence_lengths = [10, 50, 100]\n",
        "activations = [\"tanh\", \"relu\"]\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. BUILD RNN MODEL\n",
        "# --------------------------------------------------\n",
        "def build_model(seq_len, activation):\n",
        "    model = tf.keras.Sequential([\n",
        "        tf.keras.layers.Input(shape=(seq_len, 1)),\n",
        "        tf.keras.layers.SimpleRNN(\n",
        "            32, activation=activation, return_sequences=False\n",
        "        ),\n",
        "        tf.keras.layers.Dense(16, activation=\"relu\"),\n",
        "        tf.keras.layers.Dense(1)\n",
        "    ])\n",
        "    return model\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. COMPUTE GRADIENT NORMS USING GRADIENT TAPE\n",
        "# --------------------------------------------------\n",
        "gradient_results = {}\n",
        "\n",
        "for activation in activations:\n",
        "    for seq_len in sequence_lengths:\n",
        "\n",
        "        print(f\"\\nActivation: {activation} | Sequence: {seq_len}\")\n",
        "\n",
        "        X, y = create_sequences(scaled_prices, seq_len)\n",
        "\n",
        "        # Training and testing split\n",
        "        split = int(len(X) * 0.8)\n",
        "        X_train, y_train = X[:split], y[:split]\n",
        "        X_test, y_test = X[split:], y[split:]\n",
        "\n",
        "        model = build_model(seq_len, activation)\n",
        "\n",
        "        model.compile(\n",
        "            optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),\n",
        "            loss=\"mse\"\n",
        "        )\n",
        "\n",
        "        # Train the RNN\n",
        "        history = model.fit(\n",
        "            X_train, y_train,\n",
        "            epochs=5,\n",
        "            batch_size=64,\n",
        "            validation_split=0.1,\n",
        "            verbose=0\n",
        "        )\n",
        "\n",
        "        # Take a test batch for gradient analysis\n",
        "        batch_X = tf.convert_to_tensor(X_test[:32], dtype=tf.float32)\n",
        "        batch_y = tf.convert_to_tensor(y_test[:32], dtype=tf.float32)\n",
        "\n",
        "        # GradientTape records the computational graph\n",
        "        with tf.GradientTape() as tape:\n",
        "            tape.watch(batch_X)\n",
        "\n",
        "            predictions = model(batch_X, training=False)\n",
        "\n",
        "            loss = tf.reduce_mean(\n",
        "                tf.square(predictions - batch_y)\n",
        "            )\n",
        "\n",
        "        # BPTT gradients with respect to input at each time step\n",
        "        gradients = tape.gradient(loss, batch_X)\n",
        "\n",
        "        # Mean gradient magnitude across batch and features\n",
        "        gradient_norms = tf.reduce_mean(\n",
        "            tf.abs(gradients), axis=[0, 2]\n",
        "        ).numpy()\n",
        "\n",
        "        gradient_results[(activation, seq_len)] = gradient_norms\n",
        "\n",
        "        # Evaluate model\n",
        "        test_predictions = model.predict(X_test, verbose=0)\n",
        "\n",
        "        mse = mean_squared_error(y_test, test_predictions)\n",
        "\n",
        "        print(\"Test MSE:\", round(mse, 6))\n",
        "        print(\"Gradient norms:\", gradient_norms)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. GRADIENT NORMS FOR DIFFERENT SEQUENCE LENGTHS\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(12,6))\n",
        "\n",
        "for activation in activations:\n",
        "    for seq_len in sequence_lengths:\n",
        "\n",
        "        grad = gradient_results[(activation, seq_len)]\n",
        "\n",
        "        # Earlier time steps are farther from prediction\n",
        "        time_steps = np.arange(seq_len)\n",
        "\n",
        "        plt.plot(\n",
        "            time_steps,\n",
        "            grad,\n",
        "            marker=\".\",\n",
        "            label=f\"{activation}, Length={seq_len}\"\n",
        "        )\n",
        "\n",
        "plt.yscale(\"log\")\n",
        "plt.title(\"Gradient Magnitude Across Time Steps (BPTT)\")\n",
        "plt.xlabel(\"Time Step (Earlier → Recent)\")\n",
        "plt.ylabel(\"Gradient Magnitude (Log Scale)\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. COMPARE TANH VS RELU FOR EACH SEQUENCE LENGTH\n",
        "# --------------------------------------------------\n",
        "for seq_len in sequence_lengths:\n",
        "\n",
        "    plt.figure(figsize=(10,4))\n",
        "\n",
        "    for activation in activations:\n",
        "\n",
        "        grad = gradient_results[(activation, seq_len)]\n",
        "\n",
        "        plt.plot(\n",
        "            range(seq_len),\n",
        "            grad,\n",
        "            marker=\".\",\n",
        "            label=activation.upper()\n",
        "        )\n",
        "\n",
        "    plt.yscale(\"log\")\n",
        "    plt.title(f\"Gradient Analysis – Sequence Length {seq_len}\")\n",
        "    plt.xlabel(\"Time Step\")\n",
        "    plt.ylabel(\"Gradient Magnitude (Log Scale)\")\n",
        "    plt.legend()\n",
        "    plt.grid()\n",
        "    plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. GRADIENT SUMMARY TABLE\n",
        "# --------------------------------------------------\n",
        "summary = []\n",
        "\n",
        "for activation in activations:\n",
        "    for seq_len in sequence_lengths:\n",
        "\n",
        "        grad = gradient_results[(activation, seq_len)]\n",
        "\n",
        "        summary.append({\n",
        "            \"Activation\": activation,\n",
        "            \"Sequence Length\": seq_len,\n",
        "            \"Mean Gradient\": np.mean(grad),\n",
        "            \"Maximum Gradient\": np.max(grad),\n",
        "            \"Minimum Gradient\": np.min(grad),\n",
        "            \"First Time Step Gradient\": grad[0],\n",
        "            \"Last Time Step Gradient\": grad[-1]\n",
        "        })\n",
        "\n",
        "summary_df = pd.DataFrame(summary)\n",
        "\n",
        "print(\"\\nGRADIENT ANALYSIS SUMMARY\")\n",
        "print(summary_df.round(8).to_string(index=False))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. VANISHING GRADIENT VISUALIZATION\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(10,5))\n",
        "\n",
        "for activation in activations:\n",
        "\n",
        "    grad = gradient_results[(activation, 100)]\n",
        "\n",
        "    plt.plot(\n",
        "        range(100),\n",
        "        grad,\n",
        "        label=f\"{activation.upper()} (100 steps)\"\n",
        "    )\n",
        "\n",
        "plt.yscale(\"log\")\n",
        "plt.title(\"Vanishing Gradient Analysis – 100 Time Steps\")\n",
        "plt.xlabel(\"Time Step\")\n",
        "plt.ylabel(\"Gradient Magnitude\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nEXPERIMENT 15 COMPLETED SUCCESSFULLY\")"
      ]
    }
