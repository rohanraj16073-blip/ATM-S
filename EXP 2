        "\n",
        "# EXPERIMENT 2: COVARIANCE, EIGENVALUES AND EIGENVECTORS ANALYSIS\n",
        "# Google Colab - Complete runnable program\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 1. GENERATE SAMPLE PATIENT DATA (200 PATIENTS)\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "np.random.seed(42)\n",
        "n = 200\n",
        "\n",
        "hemoglobin = np.random.normal(13.5, 1.5, n)\n",
        "rbc = hemoglobin * 0.35 + np.random.normal(3.5, 0.5, n)\n",
        "glucose = np.random.normal(110, 25, n)\n",
        "cholesterol = glucose * 1.2 + np.random.normal(80, 30, n)\n",
        "bmi = np.random.normal(26, 4, n)\n",
        "\n",
        "data = pd.DataFrame({\n",
        "    \"Hemoglobin\": hemoglobin,\n",
        "    \"RBC_Count\": rbc,\n",
        "    \"Glucose\": glucose,\n",
        "    \"Cholesterol\": cholesterol,\n",
        "    \"BMI\": bmi\n",
        "})\n",
        "\n",
        "print(\"FIRST FIVE PATIENT RECORDS:\")\n",
        "print(data.head())\n",
        "\n",
        "print(\"\\nDATASET SHAPE:\")\n",
        "print(data.shape)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 2. STANDARDIZE FEATURES\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "scaler = StandardScaler()\n",
        "standardized_data = scaler.fit_transform(data)\n",
        "\n",
        "standardized_df = pd.DataFrame(\n",
        "    standardized_data,\n",
        "    columns=data.columns\n",
        ")\n",
        "\n",
        "print(\"\\nSTANDARDIZED DATA:\")\n",
        "print(standardized_df.head())\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 3. COVARIANCE MATRIX\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "covariance_matrix = np.cov(standardized_data, rowvar=False)\n",
        "\n",
        "cov_df = pd.DataFrame(\n",
        "    covariance_matrix,\n",
        "    index=data.columns,\n",
        "    columns=data.columns\n",
        ")\n",
        "\n",
        "print(\"\\nCOVARIANCE MATRIX:\")\n",
        "print(np.round(covariance_matrix, 3))\n",
        "\n",
        "# Covariance Heatmap\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.heatmap(\n",
        "    cov_df,\n",
        "    annot=True,\n",
        "    cmap=\"coolwarm\",\n",
        "    fmt=\".2f\"\n",
        ")\n",
        "\n",
        "plt.title(\"Covariance Matrix of Patient Parameters\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 4. CORRELATION MATRIX\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "correlation_matrix = np.corrcoef(\n",
        "    standardized_data,\n",
        "    rowvar=False\n",
        ")\n",
        "\n",
        "corr_df = pd.DataFrame(\n",
        "    correlation_matrix,\n",
        "    index=data.columns,\n",
        "    columns=data.columns\n",
        ")\n",
        "\n",
        "print(\"\\nCORRELATION MATRIX:\")\n",
        "print(np.round(correlation_matrix, 3))\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.heatmap(\n",
        "    corr_df,\n",
        "    annot=True,\n",
        "    cmap=\"coolwarm\",\n",
        "    vmin=-1,\n",
        "    vmax=1,\n",
        "    fmt=\".2f\"\n",
        ")\n",
        "\n",
        "plt.title(\"Correlation Matrix of Patient Parameters\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 5. EIGENVALUES AND EIGENVECTORS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "eigenvalues, eigenvectors = np.linalg.eig(covariance_matrix)\n",
        "\n",
        "# Sort in descending order\n",
        "sorted_indices = np.argsort(eigenvalues)[::-1]\n",
        "\n",
        "eigenvalues = eigenvalues[sorted_indices]\n",
        "eigenvectors = eigenvectors[:, sorted_indices]\n",
        "\n",
        "print(\"\\nSORTED EIGENVALUES:\")\n",
        "print(np.round(eigenvalues, 3))\n",
        "\n",
        "print(\"\\nSORTED EIGENVECTORS:\")\n",
        "print(np.round(eigenvectors, 3))\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 6. EXPLAINED VARIANCE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "total_variance = np.sum(eigenvalues)\n",
        "\n",
        "explained_variance_ratio = eigenvalues / total_variance\n",
        "\n",
        "cumulative_variance = np.cumsum(explained_variance_ratio)\n",
        "\n",
        "print(\"\\nEXPLAINED VARIANCE PERCENTAGE:\")\n",
        "for i, value in enumerate(explained_variance_ratio):\n",
        "    print(f\"Principal Component {i+1}: {value*100:.2f}%\")\n",
        "\n",
        "print(\"\\nCUMULATIVE EXPLAINED VARIANCE:\")\n",
        "for i, value in enumerate(cumulative_variance):\n",
        "    print(f\"PC {i+1}: {value*100:.2f}%\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 7. SCATTER PLOT WITH TOP TWO EIGENVECTORS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(9, 7))\n",
        "\n",
        "plt.scatter(\n",
        "    standardized_data[:, 0],\n",
        "    standardized_data[:, 1],\n",
        "    alpha=0.5,\n",
        "    label=\"Patient data\"\n",
        ")\n",
        "\n",
        "# Mean of standardized data\n",
        "origin = np.array([0, 0])\n",
        "\n",
        "# Draw top two eigenvectors\n",
        "for i in range(2):\n",
        "    vector = eigenvectors[:2, i] * eigenvalues[i]\n",
        "    plt.arrow(\n",
        "        origin[0], origin[1],\n",
        "        vector[0], vector[1],\n",
        "        head_width=0.15,\n",
        "        length_includes_head=True\n",
        "    )\n",
        "\n",
        "    plt.text(\n",
        "        vector[0] * 1.1,\n",
        "        vector[1] * 1.1,\n",
        "        f\"Eigenvector {i+1}\",\n",
        "        fontsize=10\n",
        "    )\n",
        "\n",
        "plt.xlabel(\"Standardized Hemoglobin\")\n",
        "plt.ylabel(\"Standardized RBC Count\")\n",
        "plt.title(\"Patient Data with Principal Eigenvectors\")\n",
        "plt.grid(True)\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 8. EIGENVALUE SCREE PLOT\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(\n",
        "    range(1, len(eigenvalues) + 1),\n",
        "    eigenvalues,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Principal Component\")\n",
        "plt.ylabel(\"Eigenvalue\")\n",
        "plt.title(\"Scree Plot of Eigenvalues\")\n",
        "plt.xticks(range(1, len(eigenvalues) + 1))\n",
        "plt.grid(True)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 9. CUMULATIVE VARIANCE PLOT\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(\n",
        "    range(1, len(cumulative_variance) + 1),\n",
        "    cumulative_variance * 100,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.axhline(\n",
        "    y=95,\n",
        "    linestyle=\"--\",\n",
        "    label=\"95% Variance\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Number of Principal Components\")\n",
        "plt.ylabel(\"Cumulative Variance (%)\")\n",
        "plt.title(\"Cumulative Explained Variance\")\n",
        "plt.xticks(range(1, len(eigenvalues) + 1))\n",
        "plt.grid(True)\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 10. FINAL SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\"*50)\n",
        "print(\"EXPERIMENT 2 COMPLETED SUCCESSFULLY\")\n",
        "print(\"=\"*50)\n",
        "\n",
        "print(\"Number of Patients:\", n)\n",
        "print(\"Number of Features:\", data.shape[1])\n",
        "\n",
        "components_95 = np.argmax(cumulative_variance >= 0.95) + 1\n",
        "\n",
        "print(\"Components required to retain 95% variance:\",\n",
        "      components_95)\n",
        "\n",
        "print(\"Total explained variance by first 2 PCs:\",\n",
        "      round(cumulative_variance[1] * 100, 2), \"%\")\n"
      ]
    }
