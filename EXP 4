        "\n",
        "# EXPERIMENT 4: ENTROPY, CROSS-ENTROPY AND KL DIVERGENCE\n",
        "# Google Colab - Complete runnable program\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.special import rel_entr\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 1. DEFINE WEATHER DISTRIBUTIONS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "# Actual observed weather distribution\n",
        "P = np.array([0.50, 0.30, 0.20])\n",
        "\n",
        "# Forecast Model A\n",
        "Q1 = np.array([0.40, 0.35, 0.25])\n",
        "\n",
        "# Forecast Model B\n",
        "Q2 = np.array([0.70, 0.20, 0.10])\n",
        "\n",
        "weather = [\"Sunny\", \"Cloudy\", \"Rainy\"]\n",
        "\n",
        "print(\"TRUE DISTRIBUTION P:\")\n",
        "print(P)\n",
        "\n",
        "print(\"\\nMODEL A DISTRIBUTION Q1:\")\n",
        "print(Q1)\n",
        "\n",
        "print(\"\\nMODEL B DISTRIBUTION Q2:\")\n",
        "print(Q2)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 2. ENTROPY\n",
        "# H(P) = -sum(P * log2(P))\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def entropy(p):\n",
        "    p = np.asarray(p, dtype=float)\n",
        "    p = p[p > 0]\n",
        "    return -np.sum(p * np.log2(p))\n",
        "\n",
        "H_P = entropy(P)\n",
        "\n",
        "print(\"\\n========== ENTROPY ==========\")\n",
        "print(\"Entropy of actual distribution:\", round(H_P, 4), \"bits\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 3. CROSS-ENTROPY\n",
        "# H(P,Q) = -sum(P * log2(Q))\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def cross_entropy(p, q):\n",
        "    eps = 1e-12\n",
        "    q = np.clip(q, eps, 1.0)\n",
        "    return -np.sum(p * np.log2(q))\n",
        "\n",
        "CE_Q1 = cross_entropy(P, Q1)\n",
        "CE_Q2 = cross_entropy(P, Q2)\n",
        "\n",
        "print(\"\\n========== CROSS-ENTROPY ==========\")\n",
        "print(\"Cross-Entropy Model A:\", round(CE_Q1, 4), \"bits\")\n",
        "print(\"Cross-Entropy Model B:\", round(CE_Q2, 4), \"bits\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 4. KL DIVERGENCE\n",
        "# KL(P||Q) = sum(P * log2(P/Q))\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def kl_divergence(p, q):\n",
        "    eps = 1e-12\n",
        "    p = np.clip(p, eps, 1.0)\n",
        "    q = np.clip(q, eps, 1.0)\n",
        "    return np.sum(p * np.log2(p / q))\n",
        "\n",
        "KL_Q1 = kl_divergence(P, Q1)\n",
        "KL_Q2 = kl_divergence(P, Q2)\n",
        "\n",
        "print(\"\\n========== KL DIVERGENCE ==========\")\n",
        "print(\"KL(P || Model A):\", round(KL_Q1, 4), \"bits\")\n",
        "print(\"KL(P || Model B):\", round(KL_Q2, 4), \"bits\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 5. VERIFY CROSS-ENTROPY = ENTROPY + KL DIVERGENCE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n========== MATHEMATICAL VERIFICATION ==========\")\n",
        "\n",
        "print(\"Model A:\")\n",
        "print(\"Cross-Entropy =\", round(CE_Q1, 4))\n",
        "print(\"Entropy + KL  =\", round(H_P + KL_Q1, 4))\n",
        "\n",
        "print(\"\\nModel B:\")\n",
        "print(\"Cross-Entropy =\", round(CE_Q2, 4))\n",
        "print(\"Entropy + KL  =\", round(H_P + KL_Q2, 4))\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 6. KL DIVERGENCE ASYMMETRY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "KL_PQ1 = kl_divergence(P, Q1)\n",
        "KL_QP1 = kl_divergence(Q1, P)\n",
        "\n",
        "print(\"\\n========== KL ASYMMETRY ==========\")\n",
        "print(\"KL(P || Q1):\", round(KL_PQ1, 4))\n",
        "print(\"KL(Q1 || P):\", round(KL_QP1, 4))\n",
        "\n",
        "print(\"KL is symmetric?\",\n",
        "      np.isclose(KL_PQ1, KL_QP1))\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 7. WEATHER DISTRIBUTION VISUALIZATION\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "x = np.arange(len(weather))\n",
        "width = 0.25\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.bar(x - width, P, width, label=\"Actual\")\n",
        "plt.bar(x, Q1, width, label=\"Model A\")\n",
        "plt.bar(x + width, Q2, width, label=\"Model B\")\n",
        "\n",
        "plt.xticks(x, weather)\n",
        "plt.ylabel(\"Probability\")\n",
        "plt.title(\"Actual Weather vs Forecast Models\")\n",
        "plt.legend()\n",
        "plt.grid(axis=\"y\", alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 8. ENTROPY AND KL COMPARISON\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "labels = [\"Entropy\", \"Model A KL\", \"Model B KL\"]\n",
        "\n",
        "values = [H_P, KL_Q1, KL_Q2]\n",
        "\n",
        "plt.figure(figsize=(7, 5))\n",
        "plt.bar(labels, values)\n",
        "\n",
        "plt.ylabel(\"Information (bits)\")\n",
        "plt.title(\"Entropy and KL Divergence Comparison\")\n",
        "plt.grid(axis=\"y\", alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 9. BINARY CROSS-ENTROPY LOSS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "true_label = 1\n",
        "\n",
        "predicted_probability = np.linspace(\n",
        "    0.01, 0.99, 200\n",
        ")\n",
        "\n",
        "epsilon = 1e-12\n",
        "\n",
        "# BCE for actual label 1\n",
        "bce_positive = -(\n",
        "    true_label * np.log(predicted_probability + epsilon)\n",
        "    + (1 - true_label)\n",
        "    * np.log(1 - predicted_probability + epsilon)\n",
        ")\n",
        "\n",
        "# BCE for actual label 0\n",
        "bce_negative = -(\n",
        "    0 * np.log(predicted_probability + epsilon)\n",
        "    + 1 * np.log(1 - predicted_probability + epsilon)\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(\n",
        "    predicted_probability,\n",
        "    bce_positive,\n",
        "    label=\"True Label = 1\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    predicted_probability,\n",
        "    bce_negative,\n",
        "    label=\"True Label = 0\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Predicted Probability of Class 1\")\n",
        "plt.ylabel(\"Binary Cross-Entropy Loss\")\n",
        "plt.title(\"Binary Cross-Entropy vs Predicted Probability\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 10. FINAL SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n========================================\")\n",
        "print(\"EXPERIMENT 4 COMPLETED SUCCESSFULLY\")\n",
        "print(\"========================================\")\n",
        "\n",
        "print(\"Actual Weather Entropy:\", round(H_P, 4), \"bits\")\n",
        "print(\"Model A Cross-Entropy:\", round(CE_Q1, 4), \"bits\")\n",
        "print(\"Model B Cross-Entropy:\", round(CE_Q2, 4), \"bits\")\n",
        "\n",
        "if CE_Q1 < CE_Q2:\n",
        "    print(\"Model A is the better weather prediction model.\")\n",
        "else:\n",
        "    print(\"Model B is the better weather prediction model.\")\n"
      ]
    }
