        "# EXPERIMENT 19: PCA AND EXPLAINED VARIANCE ANALYSIS\n",
        "# PCA From Scratch vs Scikit-learn\n",
        "# Dataset: Olivetti Faces (64x64 images)\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import fetch_olivetti_faces\n",
        "from sklearn.decomposition import PCA\n",
        "import time\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. LOAD OLIVETTI FACES DATASET\n",
        "# --------------------------------------------------\n",
        "print(\"Loading Olivetti Faces dataset...\")\n",
        "\n",
        "faces = fetch_olivetti_faces(shuffle=True, random_state=42)\n",
        "\n",
        "X = faces.data\n",
        "images = faces.images\n",
        "\n",
        "print(\"Dataset shape:\", X.shape)\n",
        "print(\"Image shape:\", images.shape)\n",
        "\n",
        "# Display sample faces\n",
        "plt.figure(figsize=(10,5))\n",
        "\n",
        "for i in range(10):\n",
        "    plt.subplot(2,5,i+1)\n",
        "    plt.imshow(images[i], cmap=\"gray\")\n",
        "    plt.axis(\"off\")\n",
        "    plt.title(f\"Face {i+1}\")\n",
        "\n",
        "plt.suptitle(\"Sample Olivetti Faces\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. PCA FROM SCRATCH USING COVARIANCE / EIGEN ANALYSIS\n",
        "# --------------------------------------------------\n",
        "def pca_from_scratch(X, n_components=None):\n",
        "\n",
        "    # Mean centering\n",
        "    mean = np.mean(X, axis=0)\n",
        "    X_centered = X - mean\n",
        "\n",
        "    # Dual covariance matrix (sample-space)\n",
        "    # Efficient for high-dimensional face images\n",
        "    covariance = np.dot(X_centered, X_centered.T)\n",
        "\n",
        "    # Eigenvalue and eigenvector decomposition\n",
        "    eigenvalues, eigenvectors = np.linalg.eigh(covariance)\n",
        "\n",
        "    # Sort eigenvalues in descending order\n",
        "    order = np.argsort(eigenvalues)[::-1]\n",
        "\n",
        "    eigenvalues = eigenvalues[order]\n",
        "    eigenvectors = eigenvectors[:, order]\n",
        "\n",
        "    # Convert sample-space eigenvectors to feature-space eigenfaces\n",
        "    eigenfaces = np.dot(X_centered.T, eigenvectors)\n",
        "\n",
        "    # Normalize eigenfaces\n",
        "    eigenfaces /= (\n",
        "        np.linalg.norm(eigenfaces, axis=0, keepdims=True) + 1e-10\n",
        "    )\n",
        "\n",
        "    # Explained variance\n",
        "    total_variance = np.sum(eigenvalues)\n",
        "    explained_variance_ratio = eigenvalues / (total_variance + 1e-10)\n",
        "\n",
        "    # Select components\n",
        "    if n_components is not None:\n",
        "        eigenfaces = eigenfaces[:, :n_components]\n",
        "        eigenvalues = eigenvalues[:n_components]\n",
        "        explained_variance_ratio = explained_variance_ratio[:n_components]\n",
        "\n",
        "    return mean, eigenfaces, eigenvalues, explained_variance_ratio\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. FIT PCA FROM SCRATCH\n",
        "# --------------------------------------------------\n",
        "start_time = time.time()\n",
        "\n",
        "mean_face, eigenfaces, eigenvalues, explained_ratio = \\\n",
        "    pca_from_scratch(X)\n",
        "\n",
        "scratch_time = time.time() - start_time\n",
        "\n",
        "print(\"\\nPCA FROM SCRATCH\")\n",
        "print(\"Eigenfaces shape:\", eigenfaces.shape)\n",
        "print(\"Time:\", round(scratch_time, 3), \"seconds\")\n",
        "\n",
        "cumulative_variance = np.cumsum(explained_ratio)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. FIND COMPONENTS FOR 95% VARIANCE\n",
        "# --------------------------------------------------\n",
        "components_95 = np.argmax(cumulative_variance >= 0.95) + 1\n",
        "\n",
        "print(\"\\nComponents needed for 95% variance:\", components_95)\n",
        "print(\"Variance retained:\", round(\n",
        "    cumulative_variance[components_95-1] * 100, 2\n",
        "), \"%\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. VERIFY WITH SCIKIT-LEARN PCA\n",
        "# --------------------------------------------------\n",
        "start_time = time.time()\n",
        "\n",
        "sk_pca = PCA()\n",
        "X_sk = sk_pca.fit_transform(X)\n",
        "\n",
        "sklearn_time = time.time() - start_time\n",
        "\n",
        "print(\"\\nSCIKIT-LEARN PCA\")\n",
        "print(\"Transformed shape:\", X_sk.shape)\n",
        "print(\"Time:\", round(sklearn_time, 3), \"seconds\")\n",
        "\n",
        "# Compare explained variance\n",
        "print(\"\\nTop 10 explained variance (scratch):\")\n",
        "print(np.round(explained_ratio[:10], 5))\n",
        "\n",
        "print(\"\\nTop 10 explained variance (sklearn):\")\n",
        "print(np.round(sk_pca.explained_variance_ratio_[:10], 5))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. SCREE PLOT\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(10,5))\n",
        "\n",
        "plt.plot(\n",
        "    range(1, len(explained_ratio)+1),\n",
        "    explained_ratio,\n",
        "    marker=\".\"\n",
        ")\n",
        "\n",
        "plt.title(\"PCA Scree Plot\")\n",
        "plt.xlabel(\"Principal Component\")\n",
        "plt.ylabel(\"Explained Variance Ratio\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. CUMULATIVE EXPLAINED VARIANCE\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(10,5))\n",
        "\n",
        "plt.plot(\n",
        "    range(1, len(cumulative_variance)+1),\n",
        "    cumulative_variance,\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "plt.axhline(\n",
        "    y=0.95,\n",
        "    linestyle=\"--\",\n",
        "    label=\"95% Variance\"\n",
        ")\n",
        "\n",
        "plt.axvline(\n",
        "    x=components_95,\n",
        "    linestyle=\"--\",\n",
        "    label=f\"{components_95} Components\"\n",
        ")\n",
        "\n",
        "plt.title(\"Cumulative Explained Variance\")\n",
        "plt.xlabel(\"Number of Components\")\n",
        "plt.ylabel(\"Cumulative Variance\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. VISUALIZE TOP EIGENFACES\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(12,5))\n",
        "\n",
        "for i in range(10):\n",
        "\n",
        "    plt.subplot(2,5,i+1)\n",
        "\n",
        "    eigenface = eigenfaces[:,i].reshape(64,64)\n",
        "\n",
        "    plt.imshow(eigenface, cmap=\"gray\")\n",
        "    plt.title(f\"PC {i+1}\")\n",
        "    plt.axis(\"off\")\n",
        "\n",
        "plt.suptitle(\"Top 10 Eigenfaces\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. RECONSTRUCT FACE USING 10, 50, 100 COMPONENTS\n",
        "# --------------------------------------------------\n",
        "sample_index = 10\n",
        "original_face = X[sample_index]\n",
        "\n",
        "component_values = [10, 50, 100]\n",
        "\n",
        "plt.figure(figsize=(12,4))\n",
        "\n",
        "# Original face\n",
        "plt.subplot(1,4,1)\n",
        "\n",
        "plt.imshow(\n",
        "    original_face.reshape(64,64),\n",
        "    cmap=\"gray\"\n",
        ")\n",
        "\n",
        "plt.title(\"Original\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "for i, n_components in enumerate(component_values):\n",
        "\n",
        "    # Project onto selected eigenfaces\n",
        "    selected_eigenfaces = eigenfaces[:, :n_components]\n",
        "\n",
        "    coefficients = np.dot(\n",
        "        original_face - mean_face,\n",
        "        selected_eigenfaces\n",
        "    )\n",
        "\n",
        "    # Reconstruct face\n",
        "    reconstructed = mean_face + np.dot(\n",
        "        coefficients,\n",
        "        selected_eigenfaces.T\n",
        "    )\n",
        "\n",
        "    plt.subplot(1,4,i+2)\n",
        "\n",
        "    plt.imshow(\n",
        "        reconstructed.reshape(64,64),\n",
        "        cmap=\"gray\"\n",
        "    )\n",
        "\n",
        "    plt.title(f\"{n_components} Components\")\n",
        "    plt.axis(\"off\")\n",
        "\n",
        "plt.suptitle(\"Face Reconstruction Using PCA\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 10. RECONSTRUCTION ERROR COMPARISON\n",
        "# --------------------------------------------------\n",
        "errors = []\n",
        "\n",
        "for n_components in component_values:\n",
        "\n",
        "    selected = eigenfaces[:, :n_components]\n",
        "\n",
        "    coefficients = np.dot(\n",
        "        X - mean_face,\n",
        "        selected\n",
        "    )\n",
        "\n",
        "    reconstructed = mean_face + np.dot(\n",
        "        coefficients,\n",
        "        selected.T\n",
        "    )\n",
        "\n",
        "    mse = np.mean((X - reconstructed)**2)\n",
        "\n",
        "    errors.append(mse)\n",
        "\n",
        "    print(\n",
        "        f\"Components: {n_components} | \"\n",
        "        f\"Reconstruction MSE: {mse:.6f}\"\n",
        "    )\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.plot(\n",
        "    component_values,\n",
        "    errors,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.title(\"PCA Reconstruction Error\")\n",
        "plt.xlabel(\"Number of Components\")\n",
        "plt.ylabel(\"Mean Squared Error\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 11. PCA COMPARISON TABLE\n",
        "# --------------------------------------------------\n",
        "comparison = {\n",
        "    \"Method\": [\"PCA From Scratch\", \"Scikit-learn PCA\"],\n",
        "    \"Execution Time (sec)\": [\n",
        "        scratch_time, sklearn_time\n",
        "    ],\n",
        "    \"Total Components\": [\n",
        "        len(explained_ratio),\n",
        "        len(sk_pca.explained_variance_ratio_)\n",
        "    ]\n",
        "}\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "comparison_df = pd.DataFrame(comparison)\n",
        "\n",
        "print(\"\\n===== PCA IMPLEMENTATION COMPARISON =====\")\n",
        "print(comparison_df.round(4).to_string(index=False))\n",
        "\n",
        "print(\"\\nEXPERIMENT 19 COMPLETED SUCCESSFULLY\")"
      ]
    }
