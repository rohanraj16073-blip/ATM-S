        "# EXPERIMENT 12: CNN ARCHITECTURE AND HYPERPARAMETER COMPARISON\n",
        "\n",
        "import tensorflow as tf\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "import pandas as pd\n",
        "\n",
        "from tensorflow.keras.datasets import cifar10\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import (\n",
        "    Conv2D, MaxPooling2D, AveragePooling2D,\n",
        "    Flatten, Dense, BatchNormalization\n",
        ")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. LOAD DATASET\n",
        "# --------------------------------------------------\n",
        "\n",
        "(x_train, y_train), (x_test, y_test) = cifar10.load_data()\n",
        "\n",
        "# Use a smaller subset to reduce execution time\n",
        "x_train = x_train[:10000].astype(\"float32\") / 255.0\n",
        "y_train = y_train[:10000]\n",
        "\n",
        "x_test = x_test[:2000].astype(\"float32\") / 255.0\n",
        "y_test = y_test[:2000]\n",
        "\n",
        "print(\"Training samples:\", x_train.shape[0])\n",
        "print(\"Testing samples:\", x_test.shape[0])\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. DEFINE CNN CONFIGURATIONS\n",
        "# --------------------------------------------------\n",
        "\n",
        "configs = [\n",
        "    {\"name\": \"2Conv-Max-3x3-BN\",\n",
        "     \"layers\": 2, \"filter\": 32, \"kernel\": 3,\n",
        "     \"pool\": \"max\", \"bn\": True, \"lr\": 0.001, \"batch\": 64},\n",
        "\n",
        "    {\"name\": \"3Conv-Max-5x5-BN\",\n",
        "     \"layers\": 3, \"filter\": 32, \"kernel\": 5,\n",
        "     \"pool\": \"max\", \"bn\": True, \"lr\": 0.001, \"batch\": 64},\n",
        "\n",
        "    {\"name\": \"4Conv-Avg-3x3-BN\",\n",
        "     \"layers\": 4, \"filter\": 32, \"kernel\": 3,\n",
        "     \"pool\": \"avg\", \"bn\": True, \"lr\": 0.001, \"batch\": 64},\n",
        "\n",
        "    {\"name\": \"2Conv-Avg-5x5-NoBN\",\n",
        "     \"layers\": 2, \"filter\": 64, \"kernel\": 5,\n",
        "     \"pool\": \"avg\", \"bn\": False, \"lr\": 0.0005, \"batch\": 32},\n",
        "\n",
        "    {\"name\": \"3Conv-Avg-3x3-NoBN\",\n",
        "     \"layers\": 3, \"filter\": 64, \"kernel\": 3,\n",
        "     \"pool\": \"avg\", \"bn\": False, \"lr\": 0.0005, \"batch\": 32},\n",
        "\n",
        "    {\"name\": \"4Conv-Max-5x5-NoBN\",\n",
        "     \"layers\": 4, \"filter\": 32, \"kernel\": 5,\n",
        "     \"pool\": \"max\", \"bn\": False, \"lr\": 0.001, \"batch\": 128}\n",
        "]\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. CNN MODEL BUILDER\n",
        "# --------------------------------------------------\n",
        "\n",
        "def build_cnn(config):\n",
        "\n",
        "    model = Sequential()\n",
        "\n",
        "    for i in range(config[\"layers\"]):\n",
        "\n",
        "        filters = config[\"filter\"] * (2 if i >= 2 else 1)\n",
        "\n",
        "        if i == 0:\n",
        "            model.add(Conv2D(\n",
        "                filters, (config[\"kernel\"], config[\"kernel\"]),\n",
        "                activation=\"relu\", padding=\"same\",\n",
        "                input_shape=(32, 32, 3)\n",
        "            ))\n",
        "        else:\n",
        "            model.add(Conv2D(\n",
        "                filters, (config[\"kernel\"], config[\"kernel\"]),\n",
        "                activation=\"relu\", padding=\"same\"\n",
        "            ))\n",
        "\n",
        "        if config[\"bn\"]:\n",
        "            model.add(BatchNormalization())\n",
        "\n",
        "        if config[\"pool\"] == \"max\":\n",
        "            model.add(MaxPooling2D(pool_size=(2, 2)))\n",
        "        else:\n",
        "            model.add(AveragePooling2D(pool_size=(2, 2)))\n",
        "\n",
        "    model.add(Flatten())\n",
        "    model.add(Dense(128, activation=\"relu\"))\n",
        "    model.add(Dense(10, activation=\"softmax\"))\n",
        "\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(\n",
        "            learning_rate=config[\"lr\"]\n",
        "        ),\n",
        "        loss=\"sparse_categorical_crossentropy\",\n",
        "        metrics=[\"accuracy\"]\n",
        "    )\n",
        "\n",
        "    return model\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. TRAIN AND COMPARE MODELS\n",
        "# --------------------------------------------------\n",
        "\n",
        "results = []\n",
        "\n",
        "for config in configs:\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(\"Training:\", config[\"name\"])\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    model = build_cnn(config)\n",
        "\n",
        "    parameter_count = model.count_params()\n",
        "\n",
        "    start_time = time.time()\n",
        "\n",
        "    history = model.fit(\n",
        "        x_train, y_train,\n",
        "        epochs=2,\n",
        "        batch_size=config[\"batch\"],\n",
        "        validation_split=0.2,\n",
        "        verbose=1\n",
        "    )\n",
        "\n",
        "    training_time = time.time() - start_time\n",
        "\n",
        "    test_loss, test_accuracy = model.evaluate(\n",
        "        x_test, y_test, verbose=0\n",
        "    )\n",
        "\n",
        "    results.append({\n",
        "        \"Configuration\": config[\"name\"],\n",
        "        \"Conv Layers\": config[\"layers\"],\n",
        "        \"Filter Size\": config[\"kernel\"],\n",
        "        \"Pooling\": config[\"pool\"],\n",
        "        \"BatchNorm\": config[\"bn\"],\n",
        "        \"Learning Rate\": config[\"lr\"],\n",
        "        \"Batch Size\": config[\"batch\"],\n",
        "        \"Accuracy (%)\": round(test_accuracy * 100, 2),\n",
        "        \"Parameters\": parameter_count,\n",
        "        \"Training Time (s)\": round(training_time, 2)\n",
        "    })\n",
        "\n",
        "    print(\"Test Accuracy:\", round(test_accuracy * 100, 2), \"%\")\n",
        "    print(\"Parameters:\", parameter_count)\n",
        "    print(\"Training Time:\", round(training_time, 2), \"seconds\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. DISPLAY COMPARISON TABLE\n",
        "# --------------------------------------------------\n",
        "\n",
        "df = pd.DataFrame(results)\n",
        "\n",
        "print(\"\\n========== CNN COMPARISON RESULTS ==========\")\n",
        "print(df.to_string(index=False))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. ACCURACY COMPARISON GRAPH\n",
        "# --------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(12, 6))\n",
        "\n",
        "plt.bar(df[\"Configuration\"], df[\"Accuracy (%)\"])\n",
        "\n",
        "plt.title(\"CNN Architecture Accuracy Comparison\")\n",
        "plt.xlabel(\"CNN Configuration\")\n",
        "plt.ylabel(\"Test Accuracy (%)\")\n",
        "plt.xticks(rotation=45, ha=\"right\")\n",
        "plt.grid(axis=\"y\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. MODEL SIZE COMPARISON\n",
        "# --------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.bar(df[\"Configuration\"], df[\"Parameters\"])\n",
        "\n",
        "plt.title(\"CNN Model Parameter Comparison\")\n",
        "plt.xlabel(\"Configuration\")\n",
        "plt.ylabel(\"Number of Parameters\")\n",
        "plt.xticks(rotation=45, ha=\"right\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. TRAINING TIME COMPARISON\n",
        "# --------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.bar(df[\"Configuration\"], df[\"Training Time (s)\"])\n",
        "\n",
        "plt.title(\"CNN Training Time Comparison\")\n",
        "plt.xlabel(\"Configuration\")\n",
        "plt.ylabel(\"Training Time (seconds)\")\n",
        "plt.xticks(rotation=45, ha=\"right\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. BEST MODEL\n",
        "# --------------------------------------------------\n",
        "\n",
        "best_model = df.loc[df[\"Accuracy (%)\"].idxmax()]\n",
        "\n",
        "print(\"\\n========== BEST CNN MODEL ==========\")\n",
        "print(best_model)\n",
        "\n",
        "print(\"\\nExperiment 12 Completed Successfully!\")"
      ]
    }
