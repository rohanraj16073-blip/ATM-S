        "# EXPERIMENT 22: ICA AND COMPONENT VISUALIZATION\n",
        "# FastICA vs PCA for Mixed Signal Separation\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "\n",
        "from scipy.signal import square, sawtooth\n",
        "from sklearn.decomposition import FastICA, PCA\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from scipy.optimize import linear_sum_assignment\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. GENERATE ORIGINAL INDEPENDENT SIGNALS\n",
        "# --------------------------------------------------\n",
        "n_samples = 2000\n",
        "t = np.linspace(0, 8, n_samples)\n",
        "\n",
        "# Three independent source signals\n",
        "s1 = np.sin(2 * np.pi * 1.0 * t)\n",
        "s2 = square(2 * np.pi * 0.5 * t)\n",
        "s3 = sawtooth(2 * np.pi * 0.7 * t)\n",
        "\n",
        "S = np.column_stack([s1, s2, s3])\n",
        "\n",
        "# Standardize original signals\n",
        "S = StandardScaler().fit_transform(S)\n",
        "\n",
        "source_names = [\"Sine Signal\", \"Square Signal\", \"Sawtooth Signal\"]\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. MIX THE SIGNALS\n",
        "# --------------------------------------------------\n",
        "A = np.array([\n",
        "    [1.0, 0.5, 0.8],\n",
        "    [0.5, 1.0, 0.3],\n",
        "    [0.8, 0.2, 1.0]\n",
        "])\n",
        "\n",
        "X = S @ A.T\n",
        "\n",
        "# Add small noise\n",
        "X += 0.05 * np.random.randn(n_samples, 3)\n",
        "\n",
        "print(\"Original Source Shape:\", S.shape)\n",
        "print(\"Mixed Signal Shape:\", X.shape)\n",
        "print(\"\\nMixing Matrix:\\n\", A)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. FASTICA SOURCE RECOVERY\n",
        "# --------------------------------------------------\n",
        "ica = FastICA(\n",
        "    n_components=3,\n",
        "    random_state=42,\n",
        "    max_iter=1000,\n",
        "    tol=0.001,\n",
        "    whiten=\"unit-variance\"\n",
        ")\n",
        "\n",
        "S_ica = ica.fit_transform(X)\n",
        "\n",
        "print(\"\\nICA COMPLETED\")\n",
        "print(\"ICA Recovered Shape:\", S_ica.shape)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. PCA COMPARISON\n",
        "# --------------------------------------------------\n",
        "pca = PCA(n_components=3)\n",
        "S_pca = pca.fit_transform(X)\n",
        "\n",
        "print(\"\\nPCA COMPLETED\")\n",
        "print(\"PCA Explained Variance:\",\n",
        "      np.round(pca.explained_variance_ratio_, 3))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. MATCH RECOVERED COMPONENTS TO ORIGINAL SOURCES\n",
        "# --------------------------------------------------\n",
        "def match_components(true_sources, recovered_sources):\n",
        "    corr_matrix = np.corrcoef(\n",
        "        true_sources.T, recovered_sources.T\n",
        "    )[:true_sources.shape[1],\n",
        "      true_sources.shape[1]:]\n",
        "\n",
        "    # Match sources using maximum absolute correlation\n",
        "    row_ind, col_ind = linear_sum_assignment(-np.abs(corr_matrix))\n",
        "\n",
        "    reordered = np.zeros_like(recovered_sources)\n",
        "    matched_corr = []\n",
        "\n",
        "    for r, c in zip(row_ind, col_ind):\n",
        "        sign = np.sign(corr_matrix[r, c])\n",
        "        reordered[:, r] = recovered_sources[:, c] * sign\n",
        "        matched_corr.append(corr_matrix[r, c])\n",
        "\n",
        "    return reordered, corr_matrix, matched_corr\n",
        "\n",
        "S_ica_matched, ica_corr_matrix, ica_matched_corr = \\\n",
        "    match_components(S, S_ica)\n",
        "\n",
        "S_pca_matched, pca_corr_matrix, pca_matched_corr = \\\n",
        "    match_components(S, S_pca)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. ICA CORRELATION ANALYSIS\n",
        "# --------------------------------------------------\n",
        "print(\"\\n===== ICA SOURCE RECOVERY CORRELATION =====\")\n",
        "\n",
        "for i, name in enumerate(source_names):\n",
        "    print(f\"{name}: {ica_matched_corr[i]:.4f}\")\n",
        "\n",
        "print(\"\\nICA Correlation Matrix:\")\n",
        "print(pd.DataFrame(\n",
        "    ica_corr_matrix,\n",
        "    index=source_names,\n",
        "    columns=[\"ICA 1\", \"ICA 2\", \"ICA 3\"]\n",
        ").round(3))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. PCA CORRELATION ANALYSIS\n",
        "# --------------------------------------------------\n",
        "print(\"\\n===== PCA SOURCE RECOVERY CORRELATION =====\")\n",
        "\n",
        "for i, name in enumerate(source_names):\n",
        "    print(f\"{name}: {pca_matched_corr[i]:.4f}\")\n",
        "\n",
        "print(\"\\nPCA Correlation Matrix:\")\n",
        "print(pd.DataFrame(\n",
        "    pca_corr_matrix,\n",
        "    index=source_names,\n",
        "    columns=[\"PC 1\", \"PC 2\", \"PC 3\"]\n",
        ").round(3))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. PLOT ORIGINAL SOURCE SIGNALS\n",
        "# --------------------------------------------------\n",
        "fig, axes = plt.subplots(3, 1, figsize=(12, 8))\n",
        "\n",
        "for i in range(3):\n",
        "    axes[i].plot(t, S[:, i])\n",
        "    axes[i].set_title(f\"Original {source_names[i]}\")\n",
        "    axes[i].set_ylabel(\"Amplitude\")\n",
        "    axes[i].grid(True)\n",
        "\n",
        "axes[-1].set_xlabel(\"Time\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. PLOT MIXED SIGNALS\n",
        "# --------------------------------------------------\n",
        "fig, axes = plt.subplots(3, 1, figsize=(12, 8))\n",
        "\n",
        "for i in range(3):\n",
        "    axes[i].plot(t, X[:, i])\n",
        "    axes[i].set_title(f\"Mixed Signal {i+1}\")\n",
        "    axes[i].set_ylabel(\"Amplitude\")\n",
        "    axes[i].grid(True)\n",
        "\n",
        "axes[-1].set_xlabel(\"Time\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 10. PLOT ICA RECOVERED SIGNALS\n",
        "# --------------------------------------------------\n",
        "fig, axes = plt.subplots(3, 1, figsize=(12, 8))\n",
        "\n",
        "for i in range(3):\n",
        "    axes[i].plot(t, S_ica_matched[:, i])\n",
        "    axes[i].set_title(f\"ICA Recovered - {source_names[i]}\")\n",
        "    axes[i].set_ylabel(\"Amplitude\")\n",
        "    axes[i].grid(True)\n",
        "\n",
        "axes[-1].set_xlabel(\"Time\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 11. PLOT PCA RECOVERED SIGNALS\n",
        "# --------------------------------------------------\n",
        "fig, axes = plt.subplots(3, 1, figsize=(12, 8))\n",
        "\n",
        "for i in range(3):\n",
        "    axes[i].plot(t, S_pca_matched[:, i])\n",
        "    axes[i].set_title(f\"PCA Component - {source_names[i]}\")\n",
        "    axes[i].set_ylabel(\"Amplitude\")\n",
        "    axes[i].grid(True)\n",
        "\n",
        "axes[-1].set_xlabel(\"Time\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 12. COMPARISON GRAPH\n",
        "# --------------------------------------------------\n",
        "comparison = pd.DataFrame({\n",
        "    \"Source\": source_names,\n",
        "    \"ICA Correlation\": np.abs(ica_matched_corr),\n",
        "    \"PCA Correlation\": np.abs(pca_matched_corr)\n",
        "})\n",
        "\n",
        "print(\"\\n===== ICA VS PCA RECOVERY =====\")\n",
        "print(comparison.round(4))\n",
        "\n",
        "comparison.set_index(\"Source\").plot(\n",
        "    kind=\"bar\",\n",
        "    figsize=(9, 5)\n",
        ")\n",
        "\n",
        "plt.title(\"ICA vs PCA – Source Recovery Correlation\")\n",
        "plt.ylabel(\"Absolute Correlation\")\n",
        "plt.ylim(0, 1.1)\n",
        "plt.xticks(rotation=20)\n",
        "plt.grid(axis=\"y\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 13. FINAL RESULT\n",
        "# --------------------------------------------------\n",
        "print(\"\\nEXPERIMENT 22 COMPLETED SUCCESSFULLY\")"
      ]
    }
