      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "\n",
        "# Setup configuration\n",
        "epochs = 5\n",
        "batch_size = 128\n",
        "learning_rate = 0.05\n",
        "\n",
        "# We will use the existing `X_train_bin` dataset already present in your kernel environment\n",
        "train_data = X_train_bin[:5000].copy()\n",
        "\n",
        "# Dictionary to hold the training history for each algorithm\n",
        "comparison_history = {}\n",
        "\n",
        "# Defined algorithms to train\n",
        "methods = {\n",
        "    'CD-1':  {'method': 'CD-1',  'k': 1},\n",
        "    'CD-5':  {'method': 'CD-5',  'k': 5},\n",
        "    'CD-10': {'method': 'CD-10', 'k': 10},\n",
        "    'PCD':   {'method': 'PCD',   'k': 1}\n",
        "}\n",
        "\n",
        "for name, params in methods.items():\n",
        "    print(f\"Training {name}...\")\n",
        "    rbm = BernoulliRBM(784, 128, learning_rate=learning_rate)\n",
        "    errors = []\n",
        "    plls = []\n",
        "\n",
        "    # Persistent state initialized for PCD\n",
        "    pcd_state = (np.random.rand(batch_size, 784) > 0.5).astype(np.float32)\n",
        "\n",
        "    start_time = time.time()\n",
        "    for epoch in range(epochs):\n",
        "        epoch_errors = []\n",
        "        # Shuffle index to avoid mutating the source array in place and triggering unexpected behaviors\n",
        "        shuffled_indices = np.random.permutation(len(train_data))\n",
        "        shuffled_data = train_data[shuffled_indices]\n",
        "\n",
        "        for i in range(0, len(shuffled_data), batch_size):\n",
        "            v_batch = shuffled_data[i:i+batch_size]\n",
        "            if len(v_batch) < batch_size:\n",
        "                continue\n",
        "\n",
        "            err, pcd_state = rbm.train_step(\n",
        "                v_batch,\n",
        "                method=params['method'],\n",
        "                k=params['k'],\n",
        "                persistent_visible=pcd_state if name == 'PCD' else None\n",
        "            )\n",
        "            epoch_errors.append(err)\n",
        "\n",
        "        errors.append(np.mean(epoch_errors))\n",
        "        plls.append(rbm.get_pseudo_log_likelihood(train_data[:1000]))\n",
        "\n",
        "    elapsed_time = time.time() - start_time\n",
        "    comparison_history[name] = {\n",
        "        'errors': errors,\n",
        "        'plls': plls,\n",
        "        'time': elapsed_time\n",
        "    }\n",
        "    print(f\"{name} successfully finished training in {elapsed_time:.2f} seconds.\")"
      ],
