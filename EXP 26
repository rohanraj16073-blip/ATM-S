      "source": [
        "# Plot the convergence results and time performance comparison\n",
        "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
        "\n",
        "# 1. Reconstruction Error Plot\n",
        "for name, data in comparison_history.items():\n",
        "    axes[0].plot(range(1, epochs + 1), data['errors'], marker='o', label=name)\n",
        "axes[0].set_title(\"Reconstruction Error (MSE) Comparison\")\n",
        "axes[0].set_xlabel(\"Epochs\")\n",
        "axes[0].set_ylabel(\"MSE\")\n",
        "axes[0].grid(True)\n",
        "axes[0].legend()\n",
        "\n",
        "# 2. Pseudo-Log-Likelihood Plot\n",
        "for name, data in comparison_history.items():\n",
        "    axes[1].plot(range(1, epochs + 1), data['plls'], marker='s', label=name)\n",
        "axes[1].set_title(\"Pseudo-Log-Likelihood Progress\")\n",
        "axes[1].set_xlabel(\"Epochs\")\n",
        "axes[1].set_ylabel(\"Estimated PLL\")\n",
        "axes[1].grid(True)\n",
        "axes[1].legend()\n",
        "\n",
        "# 3. Training Duration (Wall-clock) Plot\n",
        "times = [comparison_history[name]['time'] for name in comparison_history]\n",
        "axes[2].bar(comparison_history.keys(), times, color=['steelblue', 'darkorange', 'forestgreen', 'crimson'])\n",
        "axes[2].set_title(\"Total Computation Time (s)\")\n",
        "axes[2].set_ylabel(\"Seconds\")\n",
        "axes[2].grid(axis='y', linestyle='--')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
