        "# EXPERIMENT 8: TWO-LAYER NEURAL NETWORK WITH BACKPROPAGATION\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import make_moons\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. SIGMOID ACTIVATION\n",
        "# --------------------------------------------------\n",
        "def sigmoid(x):\n",
        "    x = np.clip(x, -500, 500)\n",
        "    return 1 / (1 + np.exp(-x))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. BINARY CROSS-ENTROPY LOSS\n",
        "# --------------------------------------------------\n",
        "def loss_function(y_true, y_pred):\n",
        "    eps = 1e-8\n",
        "    y_pred = np.clip(y_pred, eps, 1 - eps)\n",
        "    return -np.mean(\n",
        "        y_true * np.log(y_pred) +\n",
        "        (1 - y_true) * np.log(1 - y_pred)\n",
        "    )\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. INITIALIZE NETWORK PARAMETERS\n",
        "# Input Layer -> Hidden Layer -> Output Layer\n",
        "# --------------------------------------------------\n",
        "def initialize_parameters(input_size, hidden_size, output_size):\n",
        "    W1 = np.random.randn(input_size, hidden_size) * 0.5\n",
        "    b1 = np.zeros((1, hidden_size))\n",
        "\n",
        "    W2 = np.random.randn(hidden_size, output_size) * 0.5\n",
        "    b2 = np.zeros((1, output_size))\n",
        "\n",
        "    return W1, b1, W2, b2\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. FORWARD PROPAGATION\n",
        "# --------------------------------------------------\n",
        "def forward(X, W1, b1, W2, b2):\n",
        "    Z1 = np.dot(X, W1) + b1\n",
        "    A1 = sigmoid(Z1)\n",
        "\n",
        "    Z2 = np.dot(A1, W2) + b2\n",
        "    A2 = sigmoid(Z2)\n",
        "\n",
        "    return A1, A2\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. BACKPROPAGATION\n",
        "# --------------------------------------------------\n",
        "def backward(X, y, A1, A2, W2):\n",
        "    m = X.shape[0]\n",
        "\n",
        "    # Output layer gradient\n",
        "    dZ2 = (A2 - y) / m\n",
        "    dW2 = np.dot(A1.T, dZ2)\n",
        "    db2 = np.sum(dZ2, axis=0, keepdims=True)\n",
        "\n",
        "    # Hidden layer gradient\n",
        "    dZ1 = np.dot(dZ2, W2.T) * A1 * (1 - A1)\n",
        "    dW1 = np.dot(X.T, dZ1)\n",
        "    db1 = np.sum(dZ1, axis=0, keepdims=True)\n",
        "\n",
        "    return dW1, db1, dW2, db2\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. TRAIN THE NEURAL NETWORK\n",
        "# --------------------------------------------------\n",
        "def train_network(X, y, hidden_size=8, epochs=5000, learning_rate=0.5):\n",
        "\n",
        "    input_size = X.shape[1]\n",
        "    output_size = 1\n",
        "\n",
        "    W1, b1, W2, b2 = initialize_parameters(\n",
        "        input_size, hidden_size, output_size\n",
        "    )\n",
        "\n",
        "    losses = []\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "\n",
        "        # Forward pass\n",
        "        A1, A2 = forward(X, W1, b1, W2, b2)\n",
        "\n",
        "        # Calculate loss\n",
        "        loss = loss_function(y, A2)\n",
        "        losses.append(loss)\n",
        "\n",
        "        # Backward pass\n",
        "        dW1, db1, dW2, db2 = backward(\n",
        "            X, y, A1, A2, W2\n",
        "        )\n",
        "\n",
        "        # Gradient descent update\n",
        "        W1 -= learning_rate * dW1\n",
        "        b1 -= learning_rate * db1\n",
        "\n",
        "        W2 -= learning_rate * dW2\n",
        "        b2 -= learning_rate * db2\n",
        "\n",
        "    return W1, b1, W2, b2, losses\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. PREDICTION FUNCTION\n",
        "# --------------------------------------------------\n",
        "def predict(X, W1, b1, W2, b2):\n",
        "    _, probabilities = forward(X, W1, b1, W2, b2)\n",
        "    return (probabilities >= 0.5).astype(int)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. XOR DATASET\n",
        "# --------------------------------------------------\n",
        "X_xor = np.array([\n",
        "    [0, 0],\n",
        "    [0, 1],\n",
        "    [1, 0],\n",
        "    [1, 1]\n",
        "], dtype=float)\n",
        "\n",
        "y_xor = np.array([\n",
        "    [0],\n",
        "    [1],\n",
        "    [1],\n",
        "    [0]\n",
        "], dtype=float)\n",
        "\n",
        "print(\"XOR DATASET\")\n",
        "print(\"--------------------------\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. NUMERICAL GRADIENT VERIFICATION\n",
        "# --------------------------------------------------\n",
        "print(\"\\nNUMERICAL GRADIENT VERIFICATION\")\n",
        "\n",
        "W1, b1, W2, b2 = initialize_parameters(2, 8, 1)\n",
        "\n",
        "A1, A2 = forward(X_xor, W1, b1, W2, b2)\n",
        "\n",
        "dW1, db1, dW2, db2 = backward(\n",
        "    X_xor, y_xor, A1, A2, W2\n",
        ")\n",
        "\n",
        "# Verify one W1 weight\n",
        "i, j = 0, 0\n",
        "epsilon = 1e-5\n",
        "\n",
        "W1_plus = W1.copy()\n",
        "W1_minus = W1.copy()\n",
        "\n",
        "W1_plus[i, j] += epsilon\n",
        "W1_minus[i, j] -= epsilon\n",
        "\n",
        "_, pred_plus = forward(X_xor, W1_plus, b1, W2, b2)\n",
        "_, pred_minus = forward(X_xor, W1_minus, b1, W2, b2)\n",
        "\n",
        "loss_plus = loss_function(y_xor, pred_plus)\n",
        "loss_minus = loss_function(y_xor, pred_minus)\n",
        "\n",
        "numerical_gradient = (loss_plus - loss_minus) / (2 * epsilon)\n",
        "analytical_gradient = dW1[i, j]\n",
        "\n",
        "print(\"Analytical Gradient :\", analytical_gradient)\n",
        "print(\"Numerical Gradient :\", numerical_gradient)\n",
        "print(\"Gradient Difference:\",\n",
        "      abs(analytical_gradient - numerical_gradient))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 10. TRAIN XOR NETWORK\n",
        "# --------------------------------------------------\n",
        "print(\"\\nTRAINING XOR NETWORK\")\n",
        "\n",
        "W1_xor, b1_xor, W2_xor, b2_xor, loss_xor = train_network(\n",
        "    X_xor,\n",
        "    y_xor,\n",
        "    hidden_size=8,\n",
        "    epochs=10000,\n",
        "    learning_rate=1.0\n",
        ")\n",
        "\n",
        "pred_xor = predict(\n",
        "    X_xor, W1_xor, b1_xor, W2_xor, b2_xor\n",
        ")\n",
        "\n",
        "print(\"\\nXOR INPUTS:\")\n",
        "print(X_xor)\n",
        "\n",
        "print(\"\\nXOR ACTUAL OUTPUT:\")\n",
        "print(y_xor.flatten())\n",
        "\n",
        "print(\"\\nXOR PREDICTED OUTPUT:\")\n",
        "print(pred_xor.flatten())\n",
        "\n",
        "xor_accuracy = np.mean(pred_xor == y_xor) * 100\n",
        "print(\"\\nXOR Accuracy:\", xor_accuracy, \"%\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 11. TWO-MOONS NONLINEAR DATASET\n",
        "# --------------------------------------------------\n",
        "X_moons, y_moons = make_moons(\n",
        "    n_samples=300,\n",
        "    noise=0.20,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "y_moons = y_moons.reshape(-1, 1)\n",
        "\n",
        "print(\"\\nTWO-MOONS DATASET\")\n",
        "print(\"Samples:\", X_moons.shape[0])\n",
        "print(\"Features:\", X_moons.shape[1])\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 12. TRAIN TWO-MOONS NETWORK\n",
        "# --------------------------------------------------\n",
        "W1_m, b1_m, W2_m, b2_m, loss_moons = train_network(\n",
        "    X_moons,\n",
        "    y_moons,\n",
        "    hidden_size=8,\n",
        "    epochs=5000,\n",
        "    learning_rate=0.5\n",
        ")\n",
        "\n",
        "pred_moons = predict(\n",
        "    X_moons, W1_m, b1_m, W2_m, b2_m\n",
        ")\n",
        "\n",
        "moons_accuracy = np.mean(pred_moons == y_moons) * 100\n",
        "\n",
        "print(\"\\nTwo-Moons Training Accuracy:\",\n",
        "      round(moons_accuracy, 2), \"%\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 13. DECISION BOUNDARY VISUALIZATION\n",
        "# --------------------------------------------------\n",
        "def plot_decision_boundary(ax, X, y, W1, b1, W2, b2, title):\n",
        "\n",
        "    x_min, x_max = X[:, 0].min() - 0.5, X[:, 0].max() + 0.5\n",
        "    y_min, y_max = X[:, 1].min() - 0.5, X[:, 1].max() + 0.5\n",
        "\n",
        "    xx, yy = np.meshgrid(\n",
        "        np.linspace(x_min, x_max, 200),\n",
        "        np.linspace(y_min, y_max, 200)\n",
        "    )\n",
        "\n",
        "    grid = np.c_[xx.ravel(), yy.ravel()]\n",
        "\n",
        "    _, probabilities = forward(grid, W1, b1, W2, b2)\n",
        "    Z = probabilities.reshape(xx.shape)\n",
        "\n",
        "    ax.contourf(xx, yy, Z, levels=20, alpha=0.6)\n",
        "    ax.contour(xx, yy, Z, levels=[0.5], linewidths=2)\n",
        "\n",
        "    ax.scatter(\n",
        "        X[:, 0], X[:, 1],\n",
        "        c=y.flatten(),\n",
        "        edgecolors=\"black\",\n",
        "        s=70\n",
        "    )\n",
        "\n",
        "    ax.set_title(title)\n",
        "    ax.set_xlabel(\"Feature 1\")\n",
        "    ax.set_ylabel(\"Feature 2\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 14. DISPLAY ALL GRAPHS\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(14, 10))\n",
        "\n",
        "# XOR Loss\n",
        "plt.subplot(2, 2, 1)\n",
        "plt.plot(loss_xor)\n",
        "plt.title(\"XOR Training Loss\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Binary Cross-Entropy\")\n",
        "plt.grid(True)\n",
        "\n",
        "# Two-Moons Loss\n",
        "plt.subplot(2, 2, 2)\n",
        "plt.plot(loss_moons)\n",
        "plt.title(\"Two-Moons Training Loss\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Binary Cross-Entropy\")\n",
        "plt.grid(True)\n",
        "\n",
        "# XOR Decision Boundary\n",
        "plt.subplot(2, 2, 3)\n",
        "plot_decision_boundary(\n",
        "    plt.gca(),\n",
        "    X_xor,\n",
        "    y_xor,\n",
        "    W1_xor, b1_xor, W2_xor, b2_xor,\n",
        "    \"XOR Nonlinear Decision Boundary\"\n",
        ")\n",
        "\n",
        "# Two-Moons Decision Boundary\n",
        "plt.subplot(2, 2, 4)\n",
        "plot_decision_boundary(\n",
        "    plt.gca(),\n",
        "    X_moons,\n",
        "    y_moons,\n",
        "    W1_m, b1_m, W2_m, b2_m,\n",
        "    \"Two-Moons Decision Boundary\"\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 15. FINAL RESULT\n",
        "# --------------------------------------------------\n",
        "print(\"\\n===================================\")\n",
        "print(\"EXPERIMENT 8 COMPLETED\")\n",
        "print(\"===================================\")\n",
        "print(\"XOR Accuracy:\", xor_accuracy, \"%\")\n",
        "print(\"Two-Moons Accuracy:\", round(moons_accuracy, 2), \"%\")\n",
        "print(\"Final XOR Loss:\", round(loss_xor[-1], 6))\n",
        "print(\"Final Two-Moons Loss:\", round(loss_moons[-1], 6))\n",
        "print(\"===================================\")"
      ]
    }
