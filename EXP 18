        "# EXPERIMENT 18: RNN vs LSTM vs GRU\n",
        "# Hyperparameter tuning with KerasTuner\n",
        "\n",
        "!pip -q install keras-tuner\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import tensorflow as tf\n",
        "import keras_tuner as kt\n",
        "import time\n",
        "\n",
        "from tensorflow.keras.datasets import imdb\n",
        "from tensorflow.keras.preprocessing.sequence import pad_sequences\n",
        "\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. LOAD IMDB DATASET\n",
        "# --------------------------------------------------\n",
        "VOCAB_SIZE = 10000\n",
        "MAX_LEN = 150\n",
        "\n",
        "(x_train, y_train), (x_test, y_test) = imdb.load_data(\n",
        "    num_words=VOCAB_SIZE\n",
        ")\n",
        "\n",
        "# Use subsets to reduce computation time\n",
        "x_train = x_train[:10000]\n",
        "y_train = y_train[:10000]\n",
        "\n",
        "x_test = x_test[:2500]\n",
        "y_test = y_test[:2500]\n",
        "\n",
        "x_train = pad_sequences(x_train, maxlen=MAX_LEN)\n",
        "x_test = pad_sequences(x_test, maxlen=MAX_LEN)\n",
        "\n",
        "print(\"Training samples:\", x_train.shape)\n",
        "print(\"Testing samples:\", x_test.shape)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. MODEL BUILDER\n",
        "# --------------------------------------------------\n",
        "def build_model(cell_type):\n",
        "\n",
        "    def model_builder(hp):\n",
        "\n",
        "        embedding_dim = hp.Choice(\"embedding_dim\", [32, 64])\n",
        "        units = hp.Choice(\"units\", [32, 64])\n",
        "        num_layers = hp.Int(\"num_layers\", 1, 2)\n",
        "        dropout_rate = hp.Choice(\"dropout\", [0.2, 0.4])\n",
        "        learning_rate = hp.Choice(\n",
        "            \"learning_rate\", [0.001, 0.0005]\n",
        "        )\n",
        "\n",
        "        model = tf.keras.Sequential()\n",
        "        model.add(tf.keras.layers.Input(shape=(MAX_LEN,)))\n",
        "        model.add(\n",
        "            tf.keras.layers.Embedding(\n",
        "                input_dim=VOCAB_SIZE,\n",
        "                output_dim=embedding_dim\n",
        "            )\n",
        "        )\n",
        "\n",
        "        for i in range(num_layers):\n",
        "\n",
        "            return_sequences = i < num_layers - 1\n",
        "\n",
        "            if cell_type == \"RNN\":\n",
        "                layer = tf.keras.layers.SimpleRNN(\n",
        "                    units, return_sequences=return_sequences\n",
        "                )\n",
        "\n",
        "            elif cell_type == \"LSTM\":\n",
        "                layer = tf.keras.layers.LSTM(\n",
        "                    units, return_sequences=return_sequences\n",
        "                )\n",
        "\n",
        "            else:\n",
        "                layer = tf.keras.layers.GRU(\n",
        "                    units, return_sequences=return_sequences\n",
        "                )\n",
        "\n",
        "            model.add(layer)\n",
        "            model.add(tf.keras.layers.Dropout(dropout_rate))\n",
        "\n",
        "        model.add(tf.keras.layers.Dense(32, activation=\"relu\"))\n",
        "        model.add(tf.keras.layers.Dense(1, activation=\"sigmoid\"))\n",
        "\n",
        "        model.compile(\n",
        "            optimizer=tf.keras.optimizers.Adam(\n",
        "                learning_rate=learning_rate\n",
        "            ),\n",
        "            loss=\"binary_crossentropy\",\n",
        "            metrics=[\"accuracy\"]\n",
        "        )\n",
        "\n",
        "        return model\n",
        "\n",
        "    return model_builder\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. TUNE RNN, LSTM AND GRU\n",
        "# --------------------------------------------------\n",
        "cell_types = [\"RNN\", \"LSTM\", \"GRU\"]\n",
        "\n",
        "best_models = {}\n",
        "best_configs = {}\n",
        "results = {}\n",
        "\n",
        "for cell in cell_types:\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 45)\n",
        "    print(\"TUNING:\", cell)\n",
        "    print(\"=\" * 45)\n",
        "\n",
        "    tuner = kt.RandomSearch(\n",
        "        hypermodel=build_model(cell),\n",
        "        objective=\"val_accuracy\",\n",
        "        max_trials=3,\n",
        "        executions_per_trial=1,\n",
        "        directory=\"hyperparameter_tuning\",\n",
        "        project_name=cell,\n",
        "        overwrite=True\n",
        "    )\n",
        "\n",
        "    start_time = time.time()\n",
        "\n",
        "    tuner.search(\n",
        "        x_train,\n",
        "        y_train,\n",
        "        epochs=3,\n",
        "        validation_split=0.2,\n",
        "        batch_size=128,\n",
        "        verbose=1\n",
        "    )\n",
        "\n",
        "    tuning_time = time.time() - start_time\n",
        "\n",
        "    # Get best configuration and model\n",
        "    best_hp = tuner.get_best_hyperparameters(num_trials=1)[0]\n",
        "    best_model = tuner.get_best_models(num_models=1)[0]\n",
        "\n",
        "    # Evaluate best model on test data\n",
        "    test_loss, test_accuracy = best_model.evaluate(\n",
        "        x_test, y_test, verbose=0\n",
        "    )\n",
        "\n",
        "    best_models[cell] = best_model\n",
        "    best_configs[cell] = best_hp.values\n",
        "\n",
        "    results[cell] = {\n",
        "        \"Accuracy\": test_accuracy,\n",
        "        \"Test Loss\": test_loss,\n",
        "        \"Parameters\": best_model.count_params(),\n",
        "        \"Tuning Time (sec)\": tuning_time\n",
        "    }\n",
        "\n",
        "    print(\"\\nBest Hyperparameters:\", best_hp.values)\n",
        "    print(\"Test Accuracy:\", round(test_accuracy, 4))\n",
        "    print(\"Test Loss:\", round(test_loss, 4))\n",
        "    print(\"Parameters:\", best_model.count_params())\n",
        "    print(\"Tuning Time:\", round(tuning_time, 2), \"seconds\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. PERFORMANCE TABLE\n",
        "# --------------------------------------------------\n",
        "results_df = pd.DataFrame(results).T\n",
        "\n",
        "print(\"\\n===== MODEL PERFORMANCE =====\")\n",
        "print(results_df.round(4))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. BEST HYPERPARAMETER TABLE\n",
        "# --------------------------------------------------\n",
        "config_df = pd.DataFrame(best_configs).T\n",
        "\n",
        "print(\"\\n===== BEST HYPERPARAMETERS =====\")\n",
        "print(config_df)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. ACCURACY COMPARISON\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.bar(results_df.index, results_df[\"Accuracy\"])\n",
        "plt.title(\"RNN vs LSTM vs GRU - Test Accuracy\")\n",
        "plt.ylabel(\"Accuracy\")\n",
        "plt.ylim(0, 1)\n",
        "plt.grid(axis=\"y\")\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. PARAMETER COUNT COMPARISON\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.bar(results_df.index, results_df[\"Parameters\"])\n",
        "plt.title(\"Model Parameter Count Comparison\")\n",
        "plt.ylabel(\"Number of Parameters\")\n",
        "plt.grid(axis=\"y\")\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. TUNING TIME COMPARISON\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.bar(results_df.index, results_df[\"Tuning Time (sec)\"])\n",
        "plt.title(\"Hyperparameter Tuning Time\")\n",
        "plt.ylabel(\"Time (seconds)\")\n",
        "plt.grid(axis=\"y\")\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. IDENTIFY BEST MODEL\n",
        "# --------------------------------------------------\n",
        "best_cell = results_df[\"Accuracy\"].idxmax()\n",
        "\n",
        "print(\"\\nBEST MODEL:\", best_cell)\n",
        "print(\"Best Accuracy:\", round(\n",
        "    results_df.loc[best_cell, \"Accuracy\"], 4\n",
        "))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 10. SAMPLE SENTIMENT PREDICTIONS\n",
        "# --------------------------------------------------\n",
        "predictions = best_models[best_cell].predict(\n",
        "    x_test[:10], verbose=0\n",
        ")\n",
        "\n",
        "print(\"\\n===== SAMPLE PREDICTIONS =====\")\n",
        "\n",
        "for i, pred in enumerate(predictions):\n",
        "\n",
        "    predicted_sentiment = (\n",
        "        \"Positive\" if pred[0] >= 0.5 else \"Negative\"\n",
        "    )\n",
        "\n",
        "    actual_sentiment = (\n",
        "        \"Positive\" if y_test[i] == 1 else \"Negative\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Review {i+1}: Predicted={predicted_sentiment}, \"\n",
        "        f\"Actual={actual_sentiment}, \"\n",
        "        f\"Confidence={pred[0]:.3f}\"\n",
        "    )\n",
        "\n",
        "print(\"\\nEXPERIMENT 18 COMPLETED SUCCESSFULLY\")"
      ]
    }
  ]
