        "# EXPERIMENT 21: FACTOR ANALYSIS AND LATENT FACTOR INTERPRETATION\n",
        "# Employee Satisfaction Survey | Varimax Rotation | PCA Comparison\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.decomposition import FactorAnalysis, PCA\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. GENERATE SYNTHETIC EMPLOYEE SURVEY DATA\n",
        "# --------------------------------------------------\n",
        "n_employees = 300\n",
        "\n",
        "# Three underlying latent factors\n",
        "compensation = np.random.normal(0, 1, n_employees)\n",
        "work_culture = np.random.normal(0, 1, n_employees)\n",
        "career_growth = np.random.normal(0, 1, n_employees)\n",
        "\n",
        "# Generate 10 survey questions from latent factors\n",
        "data = np.column_stack([\n",
        "    3 + 0.9*compensation + 0.2*np.random.randn(n_employees),  # Q1 Salary\n",
        "    3 + 0.8*compensation + 0.3*np.random.randn(n_employees),  # Q2 Benefits\n",
        "    3 + 0.8*work_culture + 0.3*np.random.randn(n_employees), # Q3 Team spirit\n",
        "    3 + 0.9*work_culture + 0.2*np.random.randn(n_employees), # Q4 Work environment\n",
        "    3 + 0.8*work_culture + 0.3*np.random.randn(n_employees), # Q5 Work-life balance\n",
        "    3 + 0.9*career_growth + 0.2*np.random.randn(n_employees),# Q6 Career growth\n",
        "    3 + 0.8*career_growth + 0.3*np.random.randn(n_employees),# Q7 Training\n",
        "    3 + 0.7*career_growth + 0.4*np.random.randn(n_employees),# Q8 Recognition\n",
        "    3 + 0.5*work_culture + 0.4*np.random.randn(n_employees),# Q9 Manager support\n",
        "    3 + 0.5*compensation + 0.4*np.random.randn(n_employees)  # Q10 Job satisfaction\n",
        "])\n",
        "\n",
        "# Convert values to Likert scale 1–5\n",
        "data = np.clip(np.round(data), 1, 5)\n",
        "\n",
        "question_names = [\n",
        "    \"Salary Satisfaction\",\n",
        "    \"Benefits Satisfaction\",\n",
        "    \"Team Spirit\",\n",
        "    \"Work Environment\",\n",
        "    \"Work-Life Balance\",\n",
        "    \"Career Growth\",\n",
        "    \"Training Opportunities\",\n",
        "    \"Recognition\",\n",
        "    \"Manager Support\",\n",
        "    \"Job Satisfaction\"\n",
        "]\n",
        "\n",
        "df = pd.DataFrame(data, columns=question_names)\n",
        "\n",
        "print(\"EMPLOYEE SURVEY DATA\")\n",
        "print(df.head())\n",
        "print(\"\\nDataset Shape:\", df.shape)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. DESCRIPTIVE STATISTICS\n",
        "# --------------------------------------------------\n",
        "print(\"\\nDESCRIPTIVE STATISTICS\")\n",
        "print(df.describe().round(2))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. CORRELATION MATRIX\n",
        "# --------------------------------------------------\n",
        "corr = df.corr()\n",
        "\n",
        "plt.figure(figsize=(10,7))\n",
        "sns.heatmap(\n",
        "    corr,\n",
        "    annot=True,\n",
        "    cmap=\"coolwarm\",\n",
        "    fmt=\".2f\",\n",
        "    center=0\n",
        ")\n",
        "\n",
        "plt.title(\"Employee Satisfaction Correlation Matrix\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. STANDARDIZE SURVEY DATA\n",
        "# --------------------------------------------------\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(df)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. VARIMAX ROTATION FUNCTION\n",
        "# --------------------------------------------------\n",
        "def varimax(Phi, gamma=1.0, q=20, tol=1e-6):\n",
        "    \"\"\"\n",
        "    Varimax rotation of factor loading matrix.\n",
        "    \"\"\"\n",
        "    p, k = Phi.shape\n",
        "    R = np.eye(k)\n",
        "    d = 0\n",
        "\n",
        "    for _ in range(q):\n",
        "        d_old = d\n",
        "\n",
        "        Lambda = np.dot(Phi, R)\n",
        "\n",
        "        u, s, vh = np.linalg.svd(\n",
        "            np.dot(\n",
        "                Phi.T,\n",
        "                np.asarray(Lambda)**3 -\n",
        "                (gamma/p) * np.dot(\n",
        "                    Lambda,\n",
        "                    np.diag(np.diag(\n",
        "                        np.dot(Lambda.T, Lambda)\n",
        "                    ))\n",
        "                )\n",
        "            )\n",
        "        )\n",
        "\n",
        "        R = np.dot(u, vh)\n",
        "        d = np.sum(s)\n",
        "\n",
        "        if d_old != 0 and d/d_old < 1 + tol:\n",
        "            break\n",
        "\n",
        "    return np.dot(Phi, R)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. FACTOR ANALYSIS WITH 2, 3 AND 4 FACTORS\n",
        "# --------------------------------------------------\n",
        "factor_results = {}\n",
        "rotated_loadings = {}\n",
        "\n",
        "for n_factors in [2, 3, 4]:\n",
        "\n",
        "    fa = FactorAnalysis(\n",
        "        n_components=n_factors,\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "    fa.fit(X_scaled)\n",
        "\n",
        "    loadings = fa.components_.T\n",
        "\n",
        "    # Varimax rotation\n",
        "    rotated = varimax(loadings)\n",
        "\n",
        "    factor_results[n_factors] = fa\n",
        "    rotated_loadings[n_factors] = rotated\n",
        "\n",
        "    print(f\"\\nFACTOR ANALYSIS: {n_factors} FACTORS\")\n",
        "    loading_df = pd.DataFrame(\n",
        "        rotated,\n",
        "        index=question_names,\n",
        "        columns=[f\"Factor {i+1}\" for i in range(n_factors)]\n",
        "    )\n",
        "\n",
        "    print(loading_df.round(3))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. FACTOR LOADING HEATMAP FOR 3 FACTORS\n",
        "# --------------------------------------------------\n",
        "loadings_3 = rotated_loadings[3]\n",
        "\n",
        "loading_df_3 = pd.DataFrame(\n",
        "    loadings_3,\n",
        "    index=question_names,\n",
        "    columns=[\"Factor 1\", \"Factor 2\", \"Factor 3\"]\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(9,7))\n",
        "\n",
        "sns.heatmap(\n",
        "    loading_df_3,\n",
        "    annot=True,\n",
        "    cmap=\"coolwarm\",\n",
        "    center=0,\n",
        "    fmt=\".2f\"\n",
        ")\n",
        "\n",
        "plt.title(\"Varimax Rotated Factor Loadings – 3 Factors\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. COMPARE FACTOR LOADINGS FOR 2, 3 AND 4 FACTORS\n",
        "# --------------------------------------------------\n",
        "for n_factors in [2, 3, 4]:\n",
        "\n",
        "    loadings = rotated_loadings[n_factors]\n",
        "\n",
        "    plt.figure(figsize=(8,6))\n",
        "\n",
        "    sns.heatmap(\n",
        "        loadings,\n",
        "        annot=True,\n",
        "        cmap=\"coolwarm\",\n",
        "        center=0,\n",
        "        fmt=\".2f\",\n",
        "        xticklabels=[\n",
        "            f\"Factor {i+1}\" for i in range(n_factors)\n",
        "        ],\n",
        "        yticklabels=question_names\n",
        "    )\n",
        "\n",
        "    plt.title(f\"Varimax Factor Loadings – {n_factors} Factors\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. AUTOMATIC FACTOR INTERPRETATION\n",
        "# --------------------------------------------------\n",
        "print(\"\\n===== FACTOR INTERPRETATION (3-FACTOR MODEL) =====\")\n",
        "\n",
        "for i in range(3):\n",
        "\n",
        "    factor_column = loading_df_3.iloc[:, i]\n",
        "\n",
        "    top_questions = factor_column.abs().sort_values(\n",
        "        ascending=False\n",
        "    ).head(4)\n",
        "\n",
        "    print(f\"\\nFactor {i+1}:\")\n",
        "\n",
        "    for question in top_questions.index:\n",
        "        value = loading_df_3.loc[question, f\"Factor {i+1}\"]\n",
        "        print(f\"{question}: Loading = {value:.3f}\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 10. PCA COMPARISON\n",
        "# --------------------------------------------------\n",
        "pca = PCA(n_components=3)\n",
        "pca_scores = pca.fit_transform(X_scaled)\n",
        "\n",
        "print(\"\\n===== PCA RESULTS =====\")\n",
        "print(\"Explained Variance Ratio:\")\n",
        "print(np.round(pca.explained_variance_ratio_, 3))\n",
        "\n",
        "print(\"Total Variance Explained by 3 Components:\",\n",
        "      round(np.sum(pca.explained_variance_ratio_)*100, 2), \"%\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 11. PCA EXPLAINED VARIANCE GRAPH\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.bar(\n",
        "    [\"PC1\", \"PC2\", \"PC3\"],\n",
        "    pca.explained_variance_ratio_\n",
        ")\n",
        "\n",
        "plt.title(\"PCA Explained Variance – 3 Components\")\n",
        "plt.ylabel(\"Variance Ratio\")\n",
        "plt.grid(axis=\"y\")\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 12. FACTOR ANALYSIS VS PCA\n",
        "# --------------------------------------------------\n",
        "comparison = pd.DataFrame({\n",
        "    \"Method\": [\"Factor Analysis\", \"PCA\"],\n",
        "    \"Components\": [3, 3],\n",
        "    \"PCA Variance Explained (%)\": [\n",
        "        np.nan,\n",
        "        np.sum(pca.explained_variance_ratio_) * 100\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"\\n===== FA VS PCA COMPARISON =====\")\n",
        "print(comparison.round(3).to_string(index=False))\n",
        "\n",
        "print(\"\\nEXPERIMENT 21 COMPLETED SUCCESSFULLY\")"
      ]
    }
