      "source": [
        "# Greedy layer-wise training parameters\n",
        "batch_size = 128\n",
        "epochs_rbm1 = 10\n",
        "epochs_rbm2 = 10\n",
        "\n",
        "# Create Datasets\n",
        "train_dataset = tf.data.Dataset.from_tensor_slices(x_unlabeled).shuffle(10000).batch(batch_size)\n",
        "\n",
        "print(\"=== Training RBM 1 (784 -> 500) ===\")\n",
        "rbm1 = RBM(visible_dim=784, hidden_dim=500, learning_rate=0.05, k=1)\n",
        "for epoch in range(epochs_rbm1):\n",
        "    errors = []\n",
        "    for batch in train_dataset:\n",
        "        err = rbm1.train_step(batch)\n",
        "        errors.append(err.numpy())\n",
        "    print(f\"Epoch {epoch+1}/{epochs_rbm1} - Reconstruction Error: {np.mean(errors):.4f}\")\n",
        "\n",
        "# Generate activations for the second RBM layer\n",
        "hidden1_activations = []\n",
        "for batch in tf.data.Dataset.from_tensor_slices(x_unlabeled).batch(batch_size):\n",
        "    h_act = rbm1.transform(batch)\n",
        "    hidden1_activations.append(h_act)\n",
        "hidden1_activations = tf.concat(hidden1_activations, axis=0)\n",
        "\n",
        "rbm2_dataset = tf.data.Dataset.from_tensor_slices(hidden1_activations).shuffle(10000).batch(batch_size)\n",
        "\n",
        "print(\"\\n=== Training RBM 2 (500 -> 250) ===\")\n",
        "rbm2 = RBM(visible_dim=500, hidden_dim=250, learning_rate=0.05, k=1)\n",
        "for epoch in range(epochs_rbm2):\n",
        "    errors = []\n",
        "    for batch in rbm2_dataset:\n",
        "        err = rbm2.train_step(batch)\n",
        "        errors.append(err.numpy())\n",
        "    print(f\"Epoch {epoch+1}/{epochs_rbm2} - Reconstruction Error: {np.mean(errors):.4f}\")"
      ],
