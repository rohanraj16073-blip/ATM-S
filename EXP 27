        "sc2 = ax2.scatter(proj_rand[:, 0], proj_rand[:, 1], c=y_test_subset, cmap='tab10', alpha=0.8, s=15)\n",
        "ax2.set_title(\"2-D Projection of Random Init Layer 2 representations\")\n",
        "fig.colorbar(sc2, ax=ax2, ticks=range(10))\n",
        "\n",
        "plt.show()"
