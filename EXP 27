        "class RBM:\n",
        "    def __init__(self, visible_dim, hidden_dim, learning_rate=0.01, k=1):\n",
        "        self.visible_dim = visible_dim\n",
        "        self.hidden_dim = hidden_dim\n",
        "        self.learning_rate = learning_rate\n",
        "        self.k = k # Number of Gibbs sampling steps\n",
        "\n",
        "        # Initialize weights and biases\n",
        "        self.W = tf.Variable(tf.random.normal([visible_dim, hidden_dim], stddev=0.01), dtype=tf.float32)\n",
        "        self.v_bias = tf.Variable(tf.zeros([visible_dim]), dtype=tf.float32)\n",
        "        self.h_bias = tf.Variable(tf.zeros([hidden_dim]), dtype=tf.float32)\n",
        "\n",
        "    def sample_h_given_v(self, v):\n",
        "        h_prob = tf.sigmoid(tf.matmul(v, self.W) + self.h_bias)\n",
        "        h_sample = tf.cast(h_prob > tf.random.uniform(tf.shape(h_prob)), dtype=tf.float32)\n",
        "        return h_prob, h_sample\n",
        "\n",
        "    def sample_v_given_h(self, h):\n",
        "        v_prob = tf.sigmoid(tf.matmul(h, tf.transpose(self.W)) + self.v_bias)\n",
        "        v_sample = tf.cast(v_prob > tf.random.uniform(tf.shape(v_prob)), dtype=tf.float32)\n",
        "        return v_prob, v_sample\n",
        "\n",
        "    def train_step(self, v_batch):\n",
        "        with tf.GradientTape() as tape:\n",
        "            # Positive phase\n",
        "            h0_prob, h0_sample = self.sample_h_given_v(v_batch)\n",
        "\n",
        "            # Negative phase (Contrastive Divergence - k)\n",
        "            vk_sample = v_batch\n",
        "            hk_sample = h0_sample\n",
        "            for _ in range(self.k):\n",
        "                vk_prob, vk_sample = self.sample_v_given_h(hk_sample)\n",
        "                hk_prob, hk_sample = self.sample_h_given_v(vk_sample)\n",
        "\n",
        "            # Compute gradients approximation using CD\n",
        "            positive_grad = tf.matmul(tf.transpose(v_batch), h0_prob)\n",
        "            negative_grad = tf.matmul(tf.transpose(vk_prob), hk_prob)\n",
        "\n",
        "            # We approximate gradient ascent via custom updates\n",
        "            dW = (positive_grad - negative_grad) / tf.cast(tf.shape(v_batch)[0], tf.float32)\n",
        "            dv_bias = tf.reduce_mean(v_batch - vk_prob, axis=0)\n",
        "            dh_bias = tf.reduce_mean(h0_prob - hk_prob, axis=0)\n",
        "\n",
        "        # Apply weight updates manually\n",
        "        self.W.assign_add(self.learning_rate * dW)\n",
        "        self.v_bias.assign_add(self.learning_rate * dv_bias)\n",
        "        self.h_bias.assign_add(self.learning_rate * dh_bias)\n",
        "\n",
        "        # Return reconstruction error\n",
        "        recon_error = tf.reduce_mean(tf.square(v_batch - vk_prob))\n",
        "        return recon_error\n",
        "\n",
        "    def transform(self, v):\n",
        "        # Return hidden probability representation\n",
        "        return tf.sigmoid(tf.matmul(v, self.W) + self.h_bias)"
      ],
