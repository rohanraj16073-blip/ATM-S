        "# 2. Visualize learned weights of the first layer as image filters\n",
        "weights_rbm1 = rbm1.W.numpy()\n",
        "plt.figure(figsize=(10, 10))\n",
        "for i in range(64):\n",
        "    plt.subplot(8, 8, i + 1)\n",
        "    plt.imshow(weights_rbm1[:, i].reshape(28, 28), cmap='gray')\n",
        "    plt.axis('off')\n",
        "plt.suptitle('First Layer Learned Filters (First 64 RBM Units)', fontsize=16)\n",
        "plt.show()"
