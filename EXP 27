        "# 5. Compare Accuracy and Representational Feature space using t-SNE\n",
        "plt.figure(figsize=(12, 5))\n",
        "plt.plot(history_dbn.history['val_accuracy'], label='DBN Pre-trained + Fine-tuned (Val Acc)', color='blue')\n",
        "plt.plot(history_random.history['val_accuracy'], label='Randomly Initialized (Val Acc)', color='orange')\n",
        "plt.title('Validation Accuracy Comparison (1,000 Labeled Samples)')\n",
        "plt.xlabel('Epochs')\n",
        "plt.ylabel('Accuracy')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# Extract intermediate representations (layer 2 outputs) for plotting\n",
        "intermediate_dbn_model = models.Model(inputs=dbn_model.input, outputs=dbn_model.get_layer('layer2').output)\n",
        "intermediate_rand_model = models.Model(inputs=random_model.input, outputs=random_model.get_layer('layer2').output)\n",
        "\n",
        "# Take subset of testing samples for t-SNE projection\n",
        "x_test_subset = x_test[:1000]\n",
        "y_test_subset = y_test[:1000]\n",
        "\n",
        "feats_dbn = intermediate_dbn_model.predict(x_test_subset)\n",
        "feats_rand = intermediate_rand_model.predict(x_test_subset)\n",
        "\n",
        "tsne = TSNE(n_components=2, random_state=42)\n",
        "proj_dbn = tsne.fit_transform(feats_dbn)\n",
        "proj_rand = tsne.fit_transform(feats_rand)\n",
        "\n",
        "# Plot Latent Spaces\n",
        "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 7))\n",
