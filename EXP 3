      "source": [
        "\n",
        "# EXPERIMENT 3: PROBABILITY DISTRIBUTIONS AND BAYES' THEOREM\n",
        "# Google Colab - Complete runnable program\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import bernoulli, binom, poisson, uniform, norm\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# =========================================================\n",
        "# 1. BERNOULLI DISTRIBUTION\n",
        "# =========================================================\n",
        "\n",
        "p_bernoulli = 0.6\n",
        "\n",
        "bernoulli_samples = bernoulli.rvs(\n",
        "    p_bernoulli, size=1000\n",
        ")\n",
        "\n",
        "x_bernoulli = [0, 1]\n",
        "pmf_bernoulli = bernoulli.pmf(\n",
        "    x_bernoulli, p_bernoulli\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(6, 4))\n",
        "plt.bar(x_bernoulli, pmf_bernoulli)\n",
        "plt.title(\"Bernoulli Distribution\")\n",
        "plt.xlabel(\"Outcome\")\n",
        "plt.ylabel(\"Probability\")\n",
        "plt.xticks([0, 1], [\"Failure (0)\", \"Success (1)\"])\n",
        "plt.grid(axis=\"y\")\n",
        "plt.show()\n",
        "\n",
        "print(\"Bernoulli sample mean:\", np.mean(bernoulli_samples))\n",
        "\n",
        "# =========================================================\n",
        "# 2. BINOMIAL DISTRIBUTION\n",
        "# =========================================================\n",
        "\n",
        "n_binomial = 10\n",
        "p_binomial = 0.5\n",
        "\n",
        "binomial_samples = binom.rvs(\n",
        "    n_binomial, p_binomial, size=1000\n",
        ")\n",
        "\n",
        "x_binomial = np.arange(0, n_binomial + 1)\n",
        "pmf_binomial = binom.pmf(\n",
        "    x_binomial, n_binomial, p_binomial\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.bar(x_binomial, pmf_binomial)\n",
        "plt.title(\"Binomial Distribution\")\n",
        "plt.xlabel(\"Number of Successes\")\n",
        "plt.ylabel(\"Probability\")\n",
        "plt.grid(axis=\"y\")\n",
        "plt.show()\n",
        "\n",
        "print(\"Binomial sample mean:\", np.mean(binomial_samples))\n",
        "\n",
        "# =========================================================\n",
        "# 3. POISSON DISTRIBUTION\n",
        "# =========================================================\n",
        "\n",
        "lambda_poisson = 4\n",
        "\n",
        "poisson_samples = poisson.rvs(\n",
        "    lambda_poisson, size=1000\n",
        ")\n",
        "\n",
        "x_poisson = np.arange(0, 15)\n",
        "pmf_poisson = poisson.pmf(\n",
        "    x_poisson, lambda_poisson\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.bar(x_poisson, pmf_poisson)\n",
        "plt.title(\"Poisson Distribution\")\n",
        "plt.xlabel(\"Number of Events\")\n",
        "plt.ylabel(\"Probability\")\n",
        "plt.grid(axis=\"y\")\n",
        "plt.show()\n",
        "\n",
        "print(\"Poisson sample mean:\", np.mean(poisson_samples))\n",
        "\n",
        "# =========================================================\n",
        "# 4. UNIFORM DISTRIBUTION\n",
        "# =========================================================\n",
        "\n",
        "uniform_samples = uniform.rvs(\n",
        "    loc=0, scale=10, size=1000\n",
        ")\n",
        "\n",
        "x_uniform = np.linspace(0, 10, 200)\n",
        "pdf_uniform = uniform.pdf(\n",
        "    x_uniform, loc=0, scale=10\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.hist(\n",
        "    uniform_samples, bins=20,\n",
        "    density=True, alpha=0.6\n",
        ")\n",
        "plt.plot(\n",
        "    x_uniform, pdf_uniform,\n",
        "    linewidth=2\n",
        ")\n",
        "plt.title(\"Uniform Distribution\")\n",
        "plt.xlabel(\"Value\")\n",
        "plt.ylabel(\"Density\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "print(\"Uniform sample mean:\", np.mean(uniform_samples))\n",
        "\n",
        "# =========================================================\n",
        "# 5. GAUSSIAN / NORMAL DISTRIBUTION\n",
        "# =========================================================\n",
        "\n",
        "mean_normal = 50\n",
        "std_normal = 10\n",
        "\n",
        "normal_samples = norm.rvs(\n",
        "    loc=mean_normal,\n",
        "    scale=std_normal,\n",
        "    size=1000\n",
        ")\n",
        "\n",
        "x_normal = np.linspace(20, 80, 200)\n",
        "pdf_normal = norm.pdf(\n",
        "    x_normal,\n",
        "    loc=mean_normal,\n",
        "    scale=std_normal\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.hist(\n",
        "    normal_samples, bins=30,\n",
        "    density=True, alpha=0.6\n",
        ")\n",
        "plt.plot(\n",
        "    x_normal, pdf_normal,\n",
        "    linewidth=2\n",
        ")\n",
        "plt.title(\"Gaussian / Normal Distribution\")\n",
        "plt.xlabel(\"Value\")\n",
        "plt.ylabel(\"Probability Density\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "print(\"Normal sample mean:\", np.mean(normal_samples))\n",
        "print(\"Normal sample standard deviation:\",\n",
        "      np.std(normal_samples))\n",
        "\n",
        "# =========================================================\n",
        "# 6. BAYES' THEOREM - MEDICAL DIAGNOSIS\n",
        "# =========================================================\n",
        "\n",
        "# Given parameters\n",
        "prevalence = 0.01\n",
        "sensitivity = 0.95\n",
        "specificity = 0.90\n",
        "\n",
        "# P(Positive)\n",
        "p_positive = (\n",
        "    sensitivity * prevalence\n",
        "    + (1 - specificity) * (1 - prevalence)\n",
        ")\n",
        "\n",
        "# Bayes' theorem\n",
        "p_disease_given_positive = (\n",
        "    sensitivity * prevalence\n",
        "    / p_positive\n",
        ")\n",
        "\n",
        "print(\"\\n========== BAYES' THEOREM ==========\")\n",
        "print(\"Disease prevalence:\", prevalence)\n",
        "print(\"Sensitivity:\", sensitivity)\n",
        "print(\"Specificity:\", specificity)\n",
        "print(\"Probability of positive test:\",\n",
        "      round(p_positive, 4))\n",
        "\n",
        "print(\"P(Disease | Positive):\",\n",
        "      round(p_disease_given_positive, 4))\n",
        "\n",
        "print(\"Percentage chance of disease after positive test:\",\n",
        "      round(p_disease_given_positive * 100, 2), \"%\")\n",
        "\n",
        "# =========================================================\n",
        "# 7. SIMULATION OF 100,000 PATIENTS\n",
        "# =========================================================\n",
        "\n",
        "num_patients = 100000\n",
        "\n",
        "# Generate disease status\n",
        "disease_status = np.random.binomial(\n",
        "    1, prevalence, num_patients\n",
        ")\n",
        "\n",
        "# Generate test results\n",
        "test_results = np.zeros(num_patients, dtype=int)\n",
        "\n",
        "for i in range(num_patients):\n",
        "\n",
        "    if disease_status[i] == 1:\n",
        "        # Diseased: test positive based on sensitivity\n",
        "        test_results[i] = np.random.binomial(\n",
        "            1, sensitivity\n",
        "        )\n",
        "    else:\n",
        "        # Healthy: test positive based on false-positive rate\n",
        "        test_results[i] = np.random.binomial(\n",
        "            1, 1 - specificity\n",
        "        )\n",
        "\n",
        "# Count positive tests\n",
        "positive_indices = test_results == 1\n",
        "\n",
        "# Among positive tests, count diseased patients\n",
        "true_positive_count = np.sum(\n",
        "    disease_status[positive_indices] == 1\n",
        ")\n",
        "\n",
        "total_positive_count = np.sum(positive_indices)\n",
        "\n",
        "empirical_probability = (\n",
        "    true_positive_count / total_positive_count\n",
        "    if total_positive_count > 0 else 0\n",
        ")\n",
        "\n",
        "print(\"\\n========== SIMULATION RESULTS ==========\")\n",
        "print(\"Total patients:\", num_patients)\n",
        "print(\"Patients with disease:\", np.sum(disease_status))\n",
        "print(\"Total positive tests:\", total_positive_count)\n",
        "print(\"True positive cases:\", true_positive_count)\n",
        "\n",
        "print(\"Theoretical probability:\",\n",
        "      round(p_disease_given_positive, 4))\n",
        "\n",
        "print(\"Empirical probability:\",\n",
        "      round(empirical_probability, 4))\n",
        "\n",
        "print(\"Empirical percentage:\",\n",
        "      round(empirical_probability * 100, 2), \"%\")\n",
        "\n",
        "# =========================================================\n",
        "# 8. PREVALENCE VS POSTERIOR PROBABILITY\n",
        "# =========================================================\n",
        "\n",
        "prevalences = np.linspace(0.001, 0.20, 200)\n",
        "\n",
        "posterior_probabilities = (\n",
        "    sensitivity * prevalences\n",
        "    /\n",
        "    (\n",
        "        sensitivity * prevalences\n",
        "        + (1 - specificity) * (1 - prevalences)\n",
        "    )\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(\n",
        "    prevalences * 100,\n",
        "    posterior_probabilities * 100,\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Disease Prevalence (%)\")\n",
        "plt.ylabel(\"P(Disease | Positive Test) (%)\")\n",
        "plt.title(\"Posterior Probability vs Disease Prevalence\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# =========================================================\n",
        "# 9. FINAL RESULT\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\"EXPERIMENT 3 COMPLETED SUCCESSFULLY\")\n",
        "print(\"======================================\")\n"
      ]
    }
