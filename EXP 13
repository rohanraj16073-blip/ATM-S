      "source": [
        "# EXPERIMENT 13: SEQUENTIAL DATA PREPARATION AND RNN PREDICTION\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import tensorflow as tf\n",
        "\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import SimpleRNN, Dense, Dropout, Input\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. GENERATE HOURLY ELECTRICITY DEMAND DATA\n",
        "# --------------------------------------------------\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "hours = 365 * 24\n",
        "\n",
        "time_index = pd.date_range(\n",
        "    start=\"2025-01-01\",\n",
        "    periods=hours,\n",
        "    freq=\"h\"\n",
        ")\n",
        "\n",
        "hour = np.arange(hours)\n",
        "\n",
        "# Daily pattern\n",
        "daily_pattern = 200 * np.sin(2 * np.pi * hour / 24)\n",
        "\n",
        "# Weekly variation\n",
        "weekly_pattern = 80 * np.sin(2 * np.pi * hour / (24 * 7))\n",
        "\n",
        "# Seasonal variation\n",
        "seasonal_pattern = 150 * np.sin(2 * np.pi * hour / (24 * 365))\n",
        "\n",
        "# Random noise\n",
        "noise = np.random.normal(0, 40, hours)\n",
        "\n",
        "# Electricity demand\n",
        "demand = (\n",
        "    1000\n",
        "    + daily_pattern\n",
        "    + weekly_pattern\n",
        "    + seasonal_pattern\n",
        "    + noise\n",
        ")\n",
        "\n",
        "demand = np.maximum(demand, 100)\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"Timestamp\": time_index,\n",
        "    \"Electricity_Demand\": demand\n",
        "})\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. HANDLE MISSING VALUES\n",
        "# --------------------------------------------------\n",
        "\n",
        "df.loc[100:104, \"Electricity_Demand\" ] = np.nan\n",
        "\n",
        "df[\"Electricity_Demand\"] = (\n",
        "    df[\"Electricity_Demand\"]\n",
        "    .interpolate()\n",
        "    .bfill()\n",
        ")\n",
        "\n",
        "print(\"Dataset Preview:\")\n",
        "print(df.head())\n",
        "\n",
        "print(\"\\nMissing Values:\")\n",
        "print(df.isnull().sum())\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. CHRONOLOGICAL TRAIN-TEST SPLIT\n",
        "# --------------------------------------------------\n",
        "\n",
        "values = df[\"Electricity_Demand\"].values.reshape(-1, 1)\n",
        "\n",
        "split_index = int(len(values) * 0.80)\n",
        "\n",
        "train_raw = values[:split_index]\n",
        "\n",
        "# Fit scaler only on training data\n",
        "scaler = MinMaxScaler()\n",
        "\n",
        "scaler.fit(train_raw)\n",
        "\n",
        "scaled_values = scaler.transform(values)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. CREATE SLIDING WINDOW SEQUENCES\n",
        "# Previous 24 hours -> Next hour\n",
        "# --------------------------------------------------\n",
        "\n",
        "window_size = 24\n",
        "\n",
        "X = []\n",
        "y = []\n",
        "target_indices = []\n",
        "\n",
        "for i in range(window_size, len(scaled_values)):\n",
        "\n",
        "    X.append(scaled_values[i-window_size:i, 0])\n",
        "    y.append(scaled_values[i, 0])\n",
        "    target_indices.append(i)\n",
        "\n",
        "X = np.array(X)\n",
        "y = np.array(y)\n",
        "target_indices = np.array(target_indices)\n",
        "\n",
        "X = X.reshape(X.shape[0], X.shape[1], 1)\n",
        "\n",
        "# Chronological separation\n",
        "train_mask = target_indices < split_index\n",
        "test_mask = target_indices >= split_index\n",
        "\n",
        "X_train = X[train_mask]\n",
        "y_train = y[train_mask]\n",
        "\n",
        "X_test = X[test_mask]\n",
        "y_test = y[test_mask]\n",
        "\n",
        "print(\"\\nSequence Shapes:\")\n",
        "print(\"X_train:\", X_train.shape)\n",
        "print(\"y_train:\", y_train.shape)\n",
        "print(\"X_test:\", X_test.shape)\n",
        "print(\"y_test:\", y_test.shape)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. BUILD SIMPLE RNN MODEL\n",
        "# --------------------------------------------------\n",
        "\n",
        "model = Sequential([\n",
        "    Input(shape=(window_size, 1)),\n",
        "    SimpleRNN(64, activation=\"tanh\"),\n",
        "    Dropout(0.2),\n",
        "    Dense(32, activation=\"relu\"),\n",
        "    Dense(1)\n",
        "])\n",
        "\n",
        "model.compile(\n",
        "    optimizer=\"adam\",\n",
        "    loss=\"mse\",\n",
        "    metrics=[\"mae\"]\n",
        ")\n",
        "\n",
        "model.summary()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. TRAIN MODEL\n",
        "# --------------------------------------------------\n",
        "\n",
        "history = model.fit(\n",
        "    X_train,\n",
        "    y_train,\n",
        "    epochs=10,\n",
        "    batch_size=64,\n",
        "    validation_split=0.2,\n",
        "    shuffle=False,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. MAKE PREDICTIONS\n",
        "# --------------------------------------------------\n",
        "\n",
        "predictions_scaled = model.predict(X_test, verbose=0)\n",
        "\n",
        "predictions = scaler.inverse_transform(predictions_scaled)\n",
        "\n",
        "actual = scaler.inverse_transform(\n",
        "    y_test.reshape(-1, 1)\n",
        ")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. EVALUATION\n",
        "# --------------------------------------------------\n",
        "\n",
        "from sklearn.metrics import mean_squared_error, mean_absolute_error\n",
        "\n",
        "mse = mean_squared_error(actual, predictions)\n",
        "rmse = np.sqrt(mse)\n",
        "mae = mean_absolute_error(actual, predictions)\n",
        "\n",
        "print(\"\\n========== RNN RESULTS ==========\")\n",
        "print(\"MSE:\", round(mse, 2))\n",
        "print(\"RMSE:\", round(rmse, 2))\n",
        "print(\"MAE:\", round(mae, 2))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. TRAINING LOSS GRAPH\n",
        "# --------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.plot(history.history[\"loss\"], label=\"Training Loss\")\n",
        "plt.plot(history.history[\"val_loss\"], label=\"Validation Loss\")\n",
        "\n",
        "plt.title(\"RNN Training and Validation Loss\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"MSE Loss\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 10. ACTUAL VS PREDICTED DEMAND\n",
        "# --------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(14,5))\n",
        "\n",
        "plt.plot(actual[:300], label=\"Actual Demand\")\n",
        "plt.plot(predictions[:300], label=\"Predicted Demand\")\n",
        "\n",
