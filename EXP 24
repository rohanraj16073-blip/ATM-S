      "source": [
        "# EXPERIMENT 24: GRAPHICAL MODEL SAMPLING AND PROBABILISTIC INFERENCE\n",
        "# Exact Inference vs Forward Sampling vs Rejection Sampling\n",
        "\n",
        "!pip -q install pgmpy\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from pgmpy.factors.discrete import TabularCPD\n",
        "from pgmpy.inference import VariableElimination\n",
        "\n",
        "try:\n",
        "    from pgmpy.models import DiscreteBayesianNetwork as BayesianModel\n",
        "except ImportError:\n",
        "    from pgmpy.models import BayesianNetwork as BayesianModel\n",
        "\n",
        "try:\n",
        "    from pgmpy.sampling import BayesianModelSampling\n",
        "except ImportError:\n",
        "    from pgmpy.sampling import BayesianModelSampling\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. CREATE BAYESIAN NETWORK\n",
        "# --------------------------------------------------\n",
        "edges = [\n",
        "    (\"Smoking\", \"LungDisease\"),\n",
        "    (\"Pollution\", \"LungDisease\"),\n",
        "    (\"LungDisease\", \"Cough\"),\n",
        "    (\"LungDisease\", \"Xray\"),\n",
        "    (\"LungDisease\", \"Fatigue\")\n",
        "]\n",
        "\n",
        "model = BayesianModel(edges)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. DEFINE CPDs\n",
        "# State 0 = No / Negative\n",
        "# State 1 = Yes / Positive\n",
        "# --------------------------------------------------\n",
        "cpd_smoking = TabularCPD(\n",
        "    \"Smoking\", 2, [[0.70], [0.30]]\n",
        ")\n",
        "\n",
        "cpd_pollution = TabularCPD(\n",
        "    \"Pollution\", 2, [[0.80], [0.20]]\n",
        ")\n",
        "\n",
        "cpd_lung = TabularCPD(\n",
        "    \"LungDisease\", 2,\n",
        "    [[0.99, 0.95, 0.97, 0.90],\n",
        "     [0.01, 0.05, 0.03, 0.10]],\n",
        "    evidence=[\"Smoking\", \"Pollution\"],\n",
        "    evidence_card=[2, 2]\n",
        ")\n",
        "\n",
        "cpd_cough = TabularCPD(\n",
        "    \"Cough\", 2,\n",
        "    [[0.80, 0.30],\n",
        "     [0.20, 0.70]],\n",
        "    evidence=[\"LungDisease\"],\n",
        "    evidence_card=[2]\n",
        ")\n",
        "\n",
        "cpd_xray = TabularCPD(\n",
        "    \"Xray\", 2,\n",
        "    [[0.90, 0.20],\n",
        "     [0.10, 0.80]],\n",
        "    evidence=[\"LungDisease\"],\n",
        "    evidence_card=[2]\n",
        ")\n",
        "\n",
        "cpd_fatigue = TabularCPD(\n",
        "    \"Fatigue\", 2,\n",
        "    [[0.70, 0.25],\n",
        "     [0.30, 0.75]],\n",
        "    evidence=[\"LungDisease\"],\n",
        "    evidence_card=[2]\n",
        ")\n",
        "\n",
        "model.add_cpds(\n",
        "    cpd_smoking, cpd_pollution, cpd_lung,\n",
        "    cpd_cough, cpd_xray, cpd_fatigue\n",
        ")\n",
        "\n",
        "print(\"Model Valid:\", model.check_model())\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. EXACT INFERENCE USING VARIABLE ELIMINATION\n",
        "# --------------------------------------------------\n",
        "infer = VariableElimination(model)\n",
        "\n",
        "# Positive X-ray and persistent cough\n",
        "query1 = infer.query(\n",
        "    variables=[\"LungDisease\"],\n",
        "    evidence={\"Xray\": 1, \"Cough\": 1}\n",
        ")\n",
        "\n",
        "print(\"\\n===== EXACT INFERENCE =====\")\n",
        "print(\"Lung disease probability given positive X-ray and cough:\")\n",
        "print(query1)\n",
        "\n",
        "exact_prob = float(query1.values[1])\n",
        "\n",
        "# Query with smoking evidence too\n",
        "query2 = infer.query(\n",
        "    variables=[\"LungDisease\"],\n",
        "    evidence={\n",
        "        \"Xray\": 1,\n",
        "        \"Cough\": 1,\n",
        "        \"Smoking\": 1\n",
        "    }\n",
        ")\n",
        "\n",
        "query3 = infer.query(\n",
        "    variables=[\"LungDisease\"],\n",
        "    evidence={\n",
        "        \"Xray\": 1,\n",
        "        \"Cough\": 1,\n",
        "        \"Smoking\": 0\n",
        "    }\n",
        ")\n",
        "\n",
        "smoker_exact = float(query2.values[1])\n",
        "nonsmoker_exact = float(query3.values[1])\n",
        "\n",
        "print(\"\\nProbability with smoking:\", smoker_exact)\n",
        "print(\"Probability without smoking:\", nonsmoker_exact)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. FORWARD SAMPLING\n",
        "# --------------------------------------------------\n",
        "sampling = BayesianModelSampling(model)\n",
        "\n",
        "forward_samples = sampling.forward_sample(\n",
        "    size=100000,\n",
        "    seed=42,\n",
        "    show_progress=False\n",
        ")\n",
        "\n",
        "forward_df = pd.DataFrame(forward_samples)\n",
        "\n",
        "print(\"\\n===== FORWARD SAMPLING =====\")\n",
        "print(forward_df.head())\n",
        "print(\"Number of samples:\", len(forward_df))\n",
        "\n",
        "# Estimate probability of lung disease from all samples\n",
        "forward_prob = forward_df[\"LungDisease\"].mean()\n",
        "\n",
        "print(\"Forward sampling P(LungDisease):\", forward_prob)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. REJECTION SAMPLING\n",
        "# --------------------------------------------------\n",
        "# Generate a large sample and reject samples that do not\n",
        "# satisfy the evidence Xray=1 and Cough=1\n",
        "\n",
        "rejection_samples = forward_df[\n",
        "    (forward_df[\"Xray\"] == 1) &\n",
        "    (forward_df[\"Cough\"] == 1)\n",
        "].copy()\n",
        "\n",
        "print(\"\\n===== REJECTION SAMPLING =====\")\n",
        "print(\"Accepted samples:\", len(rejection_samples))\n",
        "print(\"Rejected samples:\",\n",
        "      len(forward_df) - len(rejection_samples))\n",
        "\n",
        "if len(rejection_samples) > 0:\n",
        "    rejection_prob = rejection_samples[\"LungDisease\"].mean()\n",
        "else:\n",
        "    rejection_prob = np.nan\n",
        "\n",
        "print(\"Rejection sampling probability:\",\n",
        "      rejection_prob)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. ESTIMATE PROBABILITY WITH PANDAS\n",
        "# --------------------------------------------------\n",
        "evidence_samples = forward_df[\n",
        "    (forward_df[\"Xray\"] == 1) &\n",
        "    (forward_df[\"Cough\"] == 1)\n",
        "]\n",
        "\n",
        "pandas_prob = evidence_samples[\"LungDisease\"].mean()\n",
        "\n",
        "print(\"\\n===== PANDAS ESTIMATION =====\")\n",
        "print(\"Samples satisfying evidence:\",\n",
        "      len(evidence_samples))\n",
        "\n",
        "print(\"Estimated P(LungDisease | Xray=1, Cough=1):\",\n",
        "      pandas_prob)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. CONVERGENCE ANALYSIS\n",
        "# --------------------------------------------------\n",
        "sample_sizes = [\n",
        "    500, 1000, 2000, 5000,\n",
        "    10000, 20000, 50000, 100000\n",
        "]\n",
        "\n",
        "convergence_results = []\n",
        "\n",
        "for n in sample_sizes:\n",
        "\n",
        "    subset = forward_df.iloc[:n]\n",
        "\n",
        "    accepted = subset[\n",
        "        (subset[\"Xray\"] == 1) &\n",
        "        (subset[\"Cough\"] == 1)\n",
        "    ]\n",
        "\n",
        "    if len(accepted) > 0:\n",
        "        estimate = accepted[\"LungDisease\"].mean()\n",
        "    else:\n",
        "        estimate = np.nan\n",
        "\n",
        "    convergence_results.append({\n",
        "        \"Sample Size\": n,\n",
        "        \"Accepted Samples\": len(accepted),\n",
        "        \"Estimated Probability\": estimate,\n",
        "        \"Exact Probability\": exact_prob\n",
        "    })\n",
        "\n",
        "convergence_df = pd.DataFrame(convergence_results)\n",
        "\n",
        "print(\"\\n===== CONVERGENCE TABLE =====\")\n",
        "print(convergence_df.round(4))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. CONVERGENCE GRAPH\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.plot(\n",
        "    convergence_df[\"Sample Size\"],\n",
        "    convergence_df[\"Estimated Probability\"],\n",
        "    marker=\"o\",\n",
        "    label=\"Sampling Estimate\"\n",
        ")\n",
        "\n",
        "plt.axhline(\n",
        "    exact_prob,\n",
        "    linestyle=\"--\",\n",
        "    label=\"Exact Inference\"\n",
        ")\n",
        "\n",
        "plt.xscale(\"log\")\n",
        "plt.xlabel(\"Number of Samples\")\n",
        "plt.ylabel(\"Probability of Lung Disease\")\n",
        "plt.title(\"Probabilistic Inference Convergence\")\n",
        "plt.grid(True)\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. EXACT VS APPROXIMATE COMPARISON\n",
        "# --------------------------------------------------\n",
        "comparison = pd.DataFrame({\n",
        "    \"Method\": [\n",
        "        \"Variable Elimination (Exact)\",\n",
        "        \"Forward Sampling (Unconditional)\",\n",
        "        \"Rejection Sampling\",\n",
        "        \"Pandas Evidence Estimate\"\n",
        "    ],\n",
        "    \"Estimated Probability\": [\n",
        "        exact_prob,\n",
        "        forward_prob,\n",
        "        rejection_prob,\n",
        "        pandas_prob\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"\\n===== EXACT VS APPROXIMATE RESULTS =====\")\n",
        "print(comparison.round(4))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 10. PROBABILITY COMPARISON GRAPH\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.bar(\n",
        "    comparison[\"Method\"],\n",
        "    comparison[\"Estimated Probability\"]\n",
        ")\n",
        "\n",
        "plt.axhline(\n",
        "    exact_prob,\n",
        "    linestyle=\"--\",\n",
        "    label=\"Exact Probability\"\n",
        ")\n",
        "\n",
        "plt.ylabel(\"Probability\")\n",
        "plt.title(\"Exact and Approximate Inference Comparison\")\n",
        "plt.xticks(rotation=20, ha=\"right\")\n",
        "plt.legend()\n",
        "plt.grid(axis=\"y\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 11. FINAL RESULT\n",
        "# --------------------------------------------------\n",
        "print(\"\\nEXPERIMENT 24 COMPLETED SUCCESSFULLY\")"
      ]
    }
