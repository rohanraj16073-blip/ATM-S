      "source": [
        "# Generate synthetic binary data (e.g. users' binary watched records)\n",
        "np.random.seed(42)\n",
        "n_samples = 1000\n",
        "n_visible = 784\n",
        "n_hidden = 64\n",
        "\n",
        "# Create structural pattern in user preferences (digits-like blocks or communities)\n",
        "X = (np.random.rand(n_samples, n_visible) < 0.15).astype(float)\n",
        "# Add a systematic preference correlation pattern to learn\n",
        "for i in range(n_samples):\n",
        "    if i % 3 == 0:\n",
        "        X[i, 100:200] = (np.random.rand(100) < 0.75).astype(float)\n",
        "    elif i % 3 == 1:\n",
        "        X[i, 300:400] = (np.random.rand(100) < 0.75).astype(float)\n",
        "    else:\n",
        "        X[i, 500:600] = (np.random.rand(100) < 0.75).astype(float)\n",
        "\n",
        "# Initialize RBM\n",
        "rbm = RBM(n_visible=n_visible, n_hidden=n_hidden, learning_rate=0.15)\n",
        "\n",
        "# Training settings\n",
        "epochs = 80\n",
        "batch_size = 64\n",
        "num_batches = n_samples // batch_size\n",
        "\n",
        "free_energies = []\n",
        "recon_errors = []\n",
        "\n",
        "print(\"Training RBM...\")\n",
        "for epoch in range(epochs):\n",
        "    # Shuffle dataset\n",
        "    np.random.shuffle(X)\n",
        "    epoch_errors = []\n",
        "    epoch_free_energies = []\n",
        "\n",
        "    for i in range(num_batches):\n",
        "        batch = X[i * batch_size : (i + 1) * batch_size]\n",
        "        err = rbm.contrastive_divergence(batch, steps=1)\n",
        "        epoch_errors.append(err)\n",
        "\n",
        "        # Monitor average Free Energy for validation\n",
        "        epoch_free_energies.append(np.mean(rbm.free_energy(batch)))\n",
        "\n",
        "    recon_errors.append(np.mean(epoch_errors))\n",
        "    free_energies.append(np.mean(epoch_free_energies))\n",
        "\n",
        "    if (epoch + 1) % 10 == 0 or epoch == 0:\n",
        "        print(f\"Epoch {epoch+1:02d}/{epochs} | Reconstruction Error: {recon_errors[-1]:.4f} | Free Energy: {free_energies[-1]:.2f}\")\n",
        "\n",
        "print(\"Training completed.\")"
      ],
