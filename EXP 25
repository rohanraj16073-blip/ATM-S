      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "class RBM:\n",
        "    def __init__(self, n_visible=784, n_hidden=64, learning_rate=0.1):\n",
        "        self.n_visible = n_visible\n",
        "        self.n_hidden = n_hidden\n",
        "        self.lr = learning_rate\n",
        "\n",
        "        # Initialize weights and biases\n",
        "        # Using a small random initialization for weights\n",
        "        self.W = np.random.normal(0, 0.01, (n_visible, n_hidden))\n",
        "        self.a = np.zeros(n_visible)  # Bias for visible units\n",
        "        self.b = np.zeros(n_hidden)   # Bias for hidden units\n",
        "\n",
        "    def energy(self, v, h):\n",
        "        \"\"\"\n",
        "        Compute the energy function E(v, h) = -a^T v - b^T h - v^T W h\n",
        "        v: 1D array of visible states or 2D array (batch_size, n_visible)\n",
        "        h: 1D array of hidden states or 2D array (batch_size, n_hidden)\n",
        "        \"\"\"\n",
        "        if v.ndim == 1:\n",
        "            return -np.dot(self.a, v) - np.dot(self.b, h) - np.dot(v, np.dot(self.W, h))\n",
        "        else:\n",
        "            # Batch computation\n",
        "            return -np.dot(v, self.a) - np.dot(h, self.b) - np.sum(np.dot(v, self.W) * h, axis=1)\n",
        "\n",
        "    def sigmoid(self, x):\n",
        "        return 1.0 / (1.0 + np.exp(-np.clip(x, -80, 80)))\n",
        "\n",
        "    def sample_h_given_v(self, v):\n",
        "        \"\"\"Compute p(h=1|v) and sample hidden state\"\"\"\n",
        "        activation = np.dot(v, self.W) + self.b\n",
        "        p_h = self.sigmoid(activation)\n",
        "        h_sample = (np.random.rand(*p_h.shape) < p_h).astype(float)\n",
        "        return p_h, h_sample\n",
        "\n",
        "    def sample_v_given_h(self, h):\n",
        "        \"\"\"Compute p(v=1|h) and sample visible state\"\"\"\n",
        "        activation = np.dot(h, self.W.T) + self.a\n",
        "        p_v = self.sigmoid(activation)\n",
        "        v_sample = (np.random.rand(*p_v.shape) < p_v).astype(float)\n",
        "        return p_v, v_sample\n",
        "\n",
        "    def free_energy(self, v):\n",
        "        \"\"\"F(v) = -a^T v - \\sum_j log(1 + exp(W_j v + b_j))\"\"\"\n",
        "        v_term = np.dot(v, self.a)\n",
        "        w_x_b = np.dot(v, self.W) + self.b\n",
        "        # Stability trick: log(1 + exp(x)) = x for large x\n",
        "        hidden_term = np.sum(np.log(1.0 + np.exp(-np.abs(w_x_b))) + np.maximum(w_x_b, 0), axis=1)\n",
        "        return -v_term - hidden_term\n",
        "\n",
        "    def contrastive_divergence(self, v0, steps=1):\n",
        "        \"\"\"Perform CD-1 training step\"\"\"\n",
        "        batch_size = v0.shape[0]\n",
        "\n",
        "        # Positive phase\n",
        "        ph0, h0 = self.sample_h_given_v(v0)\n",
        "\n",
        "        # Negative phase\n",
        "        vk = v0\n",
        "        hk = h0\n",
        "        for _ in range(steps):\n",
        "            pv_k, vk = self.sample_v_given_h(hk)\n",
        "            ph_k, hk = self.sample_h_given_v(vk)\n",
        "\n",
        "        # Update parameters\n",
        "        # Use probabilities (ph0, ph_k) for updates to reduce noise\n",
        "        self.W += self.lr * (np.dot(v0.T, ph0) - np.dot(vk.T, ph_k)) / batch_size\n",
        "        self.a += self.lr * np.mean(v0 - vk, axis=0)\n",
        "        self.b += self.lr * np.mean(ph0 - ph_k, axis=0)\n",
        "\n",
        "        # Return reconstruction error\n",
        "        recon_error = np.mean((v0 - pv_k) ** 2)\n",
        "        return recon_error"
      ],
