        "\n",
        "# EXPERIMENT 1: VECTOR AND MATRIX OPERATIONS FOR DEEP LEARNING\n",
        "# Google Colab - Run this entire cell\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. CUSTOMER-GENRE MATRIX (6 x 5)\n",
        "# --------------------------------------------------\n",
        "\n",
        "customer_genre = np.array([\n",
        "    [5, 4, 1, 2, 3],\n",
        "    [4, 5, 1, 1, 3],\n",
        "    [1, 2, 5, 4, 2],\n",
        "    [2, 1, 4, 5, 1],\n",
        "    [3, 3, 2, 2, 5],\n",
        "    [5, 4, 2, 1, 4]\n",
        "])\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. GENRE-BOOK MATRIX (5 x 4)\n",
        "# --------------------------------------------------\n",
        "\n",
        "genre_book = np.array([\n",
        "    [0.9, 0.2, 0.1, 0.5],\n",
        "    [0.8, 0.3, 0.2, 0.4],\n",
        "    [0.1, 0.9, 0.4, 0.2],\n",
        "    [0.2, 0.8, 0.7, 0.1],\n",
        "    [0.3, 0.2, 0.9, 0.8]\n",
        "])\n",
        "\n",
        "print(\"CUSTOMER-GENRE MATRIX:\")\n",
        "print(customer_genre)\n",
        "\n",
        "print(\"\\nGENRE-BOOK MATRIX:\")\n",
        "print(genre_book)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. DOT PRODUCT\n",
        "# --------------------------------------------------\n",
        "\n",
        "vector1 = np.array([2, 3, 4])\n",
        "vector2 = np.array([5, 6, 7])\n",
        "\n",
        "dot_product = np.dot(vector1, vector2)\n",
        "\n",
        "print(\"\\nDOT PRODUCT:\")\n",
        "print(dot_product)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. MATRIX MULTIPLICATION\n",
        "# --------------------------------------------------\n",
        "\n",
        "score_matrix = np.matmul(customer_genre, genre_book)\n",
        "\n",
        "print(\"\\nCUSTOMER-BOOK SCORE MATRIX:\")\n",
        "print(np.round(score_matrix, 2))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. TRANSPOSE\n",
        "# --------------------------------------------------\n",
        "\n",
        "print(\"\\nTRANSPOSE OF CUSTOMER-GENRE MATRIX:\")\n",
        "print(customer_genre.T)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. MATRIX INVERSE\n",
        "# --------------------------------------------------\n",
        "\n",
        "matrix = np.array([\n",
        "    [2, 1, 3],\n",
        "    [1, 2, 1],\n",
        "    [3, 1, 2]\n",
        "])\n",
        "\n",
        "inverse_matrix = np.linalg.inv(matrix)\n",
        "\n",
        "print(\"\\nINVERSE MATRIX:\")\n",
        "print(np.round(inverse_matrix, 3))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. ELEMENT-WISE OPERATIONS\n",
        "# --------------------------------------------------\n",
        "\n",
        "A = np.array([[1, 2], [3, 4]])\n",
        "B = np.array([[5, 6], [7, 8]])\n",
        "\n",
        "print(\"\\nELEMENT-WISE ADDITION:\")\n",
        "print(A + B)\n",
        "\n",
        "print(\"\\nELEMENT-WISE MULTIPLICATION:\")\n",
        "print(A * B)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. COSINE SIMILARITY\n",
        "# --------------------------------------------------\n",
        "\n",
        "def cosine_similarity(v1, v2):\n",
        "    return np.dot(v1, v2) / (\n",
        "        np.linalg.norm(v1) * np.linalg.norm(v2)\n",
        "    )\n",
        "\n",
        "similarity_matrix = np.zeros((6, 6))\n",
        "\n",
        "for i in range(6):\n",
        "    for j in range(6):\n",
        "        similarity_matrix[i, j] = cosine_similarity(\n",
        "            customer_genre[i], customer_genre[j]\n",
        "        )\n",
        "\n",
        "print(\"\\nCUSTOMER COSINE SIMILARITY MATRIX:\")\n",
        "print(np.round(similarity_matrix, 3))\n",
        "\n",
        "# Find most similar customer pair\n",
        "similarities = similarity_matrix.copy()\n",
        "np.fill_diagonal(similarities, -1)\n",
        "\n",
        "i, j = np.unravel_index(np.argmax(similarities), similarities.shape)\n",
        "\n",
        "print(f\"\\nMOST SIMILAR CUSTOMERS: Customer {i+1} and Customer {j+1}\")\n",
        "print(\"Similarity Score:\", round(similarity_matrix[i, j], 3))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. DENSE LAYER: y = Wx + b\n",
        "# --------------------------------------------------\n",
        "\n",
        "x = customer_genre[0]  # Customer 1 input vector\n",
        "\n",
        "W = np.array([\n",
        "    [0.2, 0.4, 0.1, 0.3, 0.5],\n",
        "    [0.3, 0.2, 0.5, 0.1, 0.4],\n",
        "    [0.6, 0.1, 0.2, 0.4, 0.3],\n",
        "    [0.1, 0.5, 0.3, 0.2, 0.6]\n",
        "])\n",
        "\n",
        "b = np.array([0.5, 0.2, 0.3, 0.1])\n",
        "\n",
        "y = np.dot(W, x) + b\n",
        "\n",
        "print(\"\\nDENSE LAYER CALCULATION:\")\n",
        "print(\"Input x:\", x)\n",
        "print(\"Weight matrix W:\\n\", W)\n",
        "print(\"Bias b:\", b)\n",
        "print(\"Output y = Wx + b:\")\n",
        "print(np.round(y, 2))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 10. SCORE MATRIX HEATMAP\n",
        "# --------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(9, 6))\n",
        "\n",
        "plt.imshow(score_matrix, cmap=\"YlOrRd\", aspect=\"auto\")\n",
        "\n",
        "plt.colorbar(label=\"Recommendation Score\")\n",
        "\n",
        "plt.xticks(\n",
        "    range(4),\n",
        "    [\"Book 1\", \"Book 2\", \"Book 3\", \"Book 4\"]\n",
        ")\n",
        "\n",
        "plt.yticks(\n",
        "    range(6),\n",
        "    [\"Customer 1\", \"Customer 2\", \"Customer 3\",\n",
        "     \"Customer 4\", \"Customer 5\", \"Customer 6\"]\n",
        ")\n",
        "\n",
        "plt.title(\"Customer-Book Recommendation Score Heatmap\")\n",
        "plt.xlabel(\"Books\")\n",
        "plt.ylabel(\"Customers\")\n",
        "\n",
        "for i in range(6):\n",
        "    for j in range(4):\n",
        "        plt.text(\n",
        "            j, i, f\"{score_matrix[i,j]:.1f}\",\n",
        "            ha=\"center\", va=\"center\"\n",
        "        )\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 11. CUSTOMER SIMILARITY HEATMAP\n",
        "# --------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(7, 6))\n",
        "\n",
        "plt.imshow(similarity_matrix, cmap=\"Blues\", vmin=0, vmax=1)\n",
        "\n",
        "plt.colorbar(label=\"Cosine Similarity\")\n",
        "\n",
        "plt.xticks(range(6), [f\"C{i+1}\" for i in range(6)])\n",
        "plt.yticks(range(6), [f\"C{i+1}\" for i in range(6)])\n",
        "\n",
        "plt.title(\"Customer Similarity Heatmap\")\n",
        "plt.xlabel(\"Customers\")\n",
        "plt.ylabel(\"Customers\")\n",
        "\n",
        "for i in range(6):\n",
        "    for j in range(6):\n",
        "        plt.text(\n",
        "            j, i, f\"{similarity_matrix[i,j]:.2f}\",\n",
        "            ha=\"center\", va=\"center\"\n",
        "        )\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nEXPERIMENT 1 COMPLETED SUCCESSFULLY\")\n"
      ]
    }
