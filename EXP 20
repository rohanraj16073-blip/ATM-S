        "# EXPERIMENT 20: PROBABILISTIC PCA AND RECONSTRUCTION ANALYSIS\n",
        "# Smart Factory Sensor Data | PPCA vs Standard PCA\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. GENERATE SYNTHETIC SMART FACTORY SENSOR DATA\n",
        "# --------------------------------------------------\n",
        "n_samples = 1000\n",
        "\n",
        "# Hidden manufacturing factors\n",
        "z1 = np.random.normal(0, 1, n_samples)\n",
        "z2 = np.random.normal(0, 1, n_samples)\n",
        "\n",
        "temperature = 70 + 8*z1 + 3*z2 + np.random.normal(0, 2, n_samples)\n",
        "vibration   = 20 + 5*z1 - 4*z2 + np.random.normal(0, 2, n_samples)\n",
        "pressure    = 100 + 10*z1 + 6*z2 + np.random.normal(0, 3, n_samples)\n",
        "current     = 15 + 2*z1 + 5*z2 + np.random.normal(0, 1, n_samples)\n",
        "humidity    = 45 - 6*z1 + 8*z2 + np.random.normal(0, 3, n_samples)\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"Temperature\": temperature,\n",
        "    \"Vibration\": vibration,\n",
        "    \"Pressure\": pressure,\n",
        "    \"Current\": current,\n",
        "    \"Humidity\": humidity\n",
        "})\n",
        "\n",
        "print(\"Original Sensor Dataset\")\n",
        "print(df.head())\n",
        "print(\"\\nDataset Shape:\", df.shape)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. ADD MISSING VALUES\n",
        "# --------------------------------------------------\n",
        "data_missing = df.copy()\n",
        "\n",
        "missing_mask = np.random.rand(*data_missing.shape) < 0.03\n",
        "data_missing = data_missing.mask(missing_mask)\n",
        "\n",
        "print(\"\\nMissing Values Before Imputation:\")\n",
        "print(data_missing.isnull().sum())\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. HANDLE MISSING VALUES\n",
        "# --------------------------------------------------\n",
        "imputer = SimpleImputer(strategy=\"mean\")\n",
        "data_imputed = imputer.fit_transform(data_missing)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. STANDARDIZE DATA\n",
        "# --------------------------------------------------\n",
        "scaler = StandardScaler()\n",
        "\n",
        "X_scaled = scaler.fit_transform(data_imputed)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. FIT STANDARD PCA\n",
        "# --------------------------------------------------\n",
        "pca_full = PCA()\n",
        "pca_full.fit(X_scaled)\n",
        "\n",
        "explained_variance = pca_full.explained_variance_ratio_\n",
        "cumulative_variance = np.cumsum(explained_variance)\n",
        "\n",
        "print(\"\\nPCA Explained Variance Ratio:\")\n",
        "print(np.round(explained_variance, 4))\n",
        "\n",
        "print(\"\\nCumulative Explained Variance:\")\n",
        "print(np.round(cumulative_variance, 4))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. PPCA NOISE VARIANCE ESTIMATION\n",
        "# --------------------------------------------------\n",
        "# sklearn PCA estimates residual noise variance\n",
        "ppca_model = PCA(n_components=2)\n",
        "X_ppca = ppca_model.fit_transform(X_scaled)\n",
        "\n",
        "estimated_noise_variance = ppca_model.noise_variance_\n",
        "\n",
        "print(\"\\nPPCA MODEL\")\n",
        "print(\"Selected Components:\", ppca_model.n_components_)\n",
        "print(\"Estimated Noise Variance (sigma^2):\",\n",
        "      round(estimated_noise_variance, 6))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. SCREE PLOT\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.plot(\n",
        "    range(1, len(explained_variance)+1),\n",
        "    explained_variance,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.title(\"PCA Scree Plot – Sensor Data\")\n",
        "plt.xlabel(\"Principal Component\")\n",
        "plt.ylabel(\"Explained Variance Ratio\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. CUMULATIVE VARIANCE\n",
        "# --------------------------------------------------\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.plot(\n",
        "    range(1, len(cumulative_variance)+1),\n",
        "    cumulative_variance,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.axhline(0.95, linestyle=\"--\", label=\"95% Variance\")\n",
        "\n",
        "plt.title(\"Cumulative Explained Variance\")\n",
        "plt.xlabel(\"Number of Components\")\n",
        "plt.ylabel(\"Cumulative Variance\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. RECONSTRUCTION ERROR VS COMPONENT COUNT\n",
        "# --------------------------------------------------\n",
        "component_counts = [1, 2, 3, 4]\n",
        "reconstruction_errors = []\n",
        "noise_variances = []\n",
        "\n",
        "for k in component_counts:\n",
        "\n",
        "    pca = PCA(n_components=k)\n",
        "    scores = pca.fit_transform(X_scaled)\n",
        "    reconstructed = pca.inverse_transform(scores)\n",
        "\n",
        "    mse = mean_squared_error(X_scaled, reconstructed)\n",
        "\n",
        "    reconstruction_errors.append(mse)\n",
        "    noise_variances.append(pca.noise_variance_)\n",
        "\n",
        "    print(\n",
        "        f\"Components={k} | \"\n",
        "        f\"Reconstruction MSE={mse:.6f} | \"\n",
        "        f\"Estimated Noise Variance={pca.noise_variance_:.6f}\"\n",
        "    )\n",
        "\n",
        "# Reconstruction error graph\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.plot(\n",
        "    component_counts,\n",
        "    reconstruction_errors,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.title(\"Reconstruction Error vs Number of Components\")\n",
        "plt.xlabel(\"Number of Components\")\n",
        "plt.ylabel(\"Mean Squared Error\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 10. PCA VS PPCA RECONSTRUCTION\n",
        "# --------------------------------------------------\n",
        "n_components = 2\n",
        "\n",
        "pca = PCA(n_components=n_components)\n",
        "X_pca = pca.fit_transform(X_scaled)\n",
        "reconstructed_pca = pca.inverse_transform(X_pca)\n",
        "\n",
        "ppca = PCA(n_components=n_components)\n",
        "X_prob = ppca.fit_transform(X_scaled)\n",
        "reconstructed_ppca = ppca.inverse_transform(X_prob)\n",
        "\n",
        "pca_error = mean_squared_error(X_scaled, reconstructed_pca)\n",
        "ppca_error = mean_squared_error(X_scaled, reconstructed_ppca)\n",
        "\n",
        "print(\"\\nPCA vs PPCA Reconstruction\")\n",
        "print(\"PCA Reconstruction MSE :\", round(pca_error, 6))\n",
        "print(\"PPCA Reconstruction MSE:\", round(ppca_error, 6))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 11. SENSOR RECONSTRUCTION VISUALIZATION\n",
        "# --------------------------------------------------\n",
        "sensor_names = df.columns\n",
        "\n",
        "sample_index = 20\n",
        "\n",
        "plt.figure(figsize=(12,5))\n",
        "\n",
        "plt.plot(\n",
        "    sensor_names,\n",
        "    X_scaled[sample_index],\n",
        "    marker=\"o\",\n",
        "    label=\"Original\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    sensor_names,\n",
        "    reconstructed_pca[sample_index],\n",
        "    marker=\"s\",\n",
        "    label=\"PCA Reconstruction\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    sensor_names,\n",
        "    reconstructed_ppca[sample_index],\n",
        "    marker=\"^\",\n",
        "    label=\"PPCA Reconstruction\"\n",
        ")\n",
        "\n",
        "plt.title(\"Sensor Data Reconstruction Comparison\")\n",
        "plt.xlabel(\"Sensor\")\n",
        "plt.ylabel(\"Standardized Value\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 12. GENERATE NEW SENSOR SAMPLES FROM PPCA MODEL\n",
        "# --------------------------------------------------\n",
        "# Approximate PPCA generative model using retained components\n",
        "k = 2\n",
        "\n",
        "components = ppca.components_[:k]\n",
        "latent_dim = k\n",
        "\n",
        "# Latent variable samples\n",
        "Z_new = np.random.normal(0, 1, (10, latent_dim))\n",
        "\n",
        "# Generate new standardized sensor observations\n",
        "X_new = np.dot(Z_new, components)\n",
        "\n",
        "# Add isotropic Gaussian noise\n",
        "X_new += np.random.normal(\n",
        "    0,\n",
        "    np.sqrt(max(estimated_noise_variance, 0)),\n",
        "    X_new.shape\n",
        ")\n",
        "\n",
        "# Convert back to original sensor scale\n",
        "X_generated = scaler.inverse_transform(X_new)\n",
        "\n",
        "generated_df = pd.DataFrame(\n",
        "    X_generated,\n",
        "    columns=sensor_names\n",
        ")\n",
        "\n",
        "print(\"\\nGENERATED NEW SENSOR DATA\")\n",
        "print(generated_df.round(2))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 13. MODEL COMPARISON TABLE\n",
        "# --------------------------------------------------\n",
        "comparison_df = pd.DataFrame({\n",
        "    \"Model\": [\"PCA\", \"PPCA\"],\n",
        "    \"Components\": [2, 2],\n",
        "    \"Reconstruction MSE\": [pca_error, ppca_error],\n",
        "    \"Estimated Noise Variance\": [\n",
        "        PCA(n_components=2).fit(X_scaled).noise_variance_,\n",
        "        ppca.noise_variance_\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"\\nMODEL COMPARISON\")\n",
        "print(comparison_df.round(6).to_string(index=False))\n",
        "\n",
        "print(\"\\nEXPERIMENT 20 COMPLETED SUCCESSFULLY\")"
      ]
    }
