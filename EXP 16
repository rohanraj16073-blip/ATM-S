        "# EXPERIMENT 16: LSTM AND RNN PERFORMANCE COMPARISON\n",
        "# Food Delivery Order Forecasting\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import tensorflow as tf\n",
        "import time\n",
        "\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 1. GENERATE 2 YEARS OF DAILY ORDER DATA\n",
        "# -------------------------------------------------\n",
        "days = 730\n",
        "day = np.arange(days)\n",
        "\n",
        "weekly_pattern = 120 * np.sin(2 * np.pi * day / 7)\n",
        "seasonal_pattern = 250 * np.sin(2 * np.pi * day / 365)\n",
        "trend = 0.35 * day\n",
        "\n",
        "# Festival-like demand spikes\n",
        "festival_effect = np.zeros(days)\n",
        "festival_days = [50, 150, 250, 350, 450, 550, 650, 700]\n",
        "\n",
        "for fd in festival_days:\n",
        "    festival_effect[fd:fd+4] += 250\n",
        "\n",
        "noise = np.random.normal(0, 70, days)\n",
        "\n",
        "orders = (\n",
        "    1200 + trend + weekly_pattern +\n",
        "    seasonal_pattern + festival_effect + noise\n",
        ")\n",
        "\n",
        "orders = np.maximum(orders, 100)\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"Day\": day,\n",
        "    \"Orders\": orders\n",
        "})\n",
        "\n",
        "print(\"Dataset Preview:\")\n",
        "print(df.head())\n",
        "\n",
        "# Dataset visualization\n",
        "plt.figure(figsize=(12,4))\n",
        "plt.plot(df[\"Day\"], df[\"Orders\"])\n",
        "plt.title(\"Daily Food Delivery Orders - 2 Years\")\n",
        "plt.xlabel(\"Day\")\n",
        "plt.ylabel(\"Number of Orders\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 2. NORMALIZE DATA\n",
        "# -------------------------------------------------\n",
        "scaler = MinMaxScaler()\n",
        "\n",
        "scaled_orders = scaler.fit_transform(\n",
        "    orders.reshape(-1,1)\n",
        ")\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 3. CREATE 30-DAY SEQUENCES\n",
        "# -------------------------------------------------\n",
        "LOOKBACK = 30\n",
        "\n",
        "def create_sequences(data, lookback=30):\n",
        "    X, y = [], []\n",
        "\n",
        "    for i in range(lookback, len(data)):\n",
        "        X.append(data[i-lookback:i])\n",
        "        y.append(data[i])\n",
        "\n",
        "    return np.array(X), np.array(y)\n",
        "\n",
        "X, y = create_sequences(scaled_orders, LOOKBACK)\n",
        "\n",
        "# Chronological train/test split\n",
        "split = int(len(X) * 0.80)\n",
        "\n",
        "X_train_full, X_test = X[:split], X[split:]\n",
        "y_train_full, y_test = y[:split], y[split:]\n",
        "\n",
        "# Validation split from training data\n",
        "val_split = int(len(X_train_full) * 0.85)\n",
        "\n",
        "X_train, X_val = X_train_full[:val_split], X_train_full[val_split:]\n",
        "y_train, y_val = y_train_full[:val_split], y_train_full[val_split:]\n",
        "\n",
        "print(\"\\nTraining samples:\", X_train.shape[0])\n",
        "print(\"Validation samples:\", X_val.shape[0])\n",
        "print(\"Testing samples:\", X_test.shape[0])\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 4. BUILD MODELS\n",
        "# -------------------------------------------------\n",
        "UNITS = 64\n",
        "\n",
        "def build_rnn():\n",
        "    model = tf.keras.Sequential([\n",
        "        tf.keras.layers.Input(shape=(LOOKBACK, 1)),\n",
        "        tf.keras.layers.SimpleRNN(UNITS, activation=\"tanh\"),\n",
        "        tf.keras.layers.Dense(32, activation=\"relu\"),\n",
        "        tf.keras.layers.Dense(1)\n",
        "    ])\n",
        "    return model\n",
        "\n",
        "def build_lstm():\n",
        "    model = tf.keras.Sequential([\n",
        "        tf.keras.layers.Input(shape=(LOOKBACK, 1)),\n",
        "        tf.keras.layers.LSTM(UNITS),\n",
        "        tf.keras.layers.Dense(32, activation=\"relu\"),\n",
        "        tf.keras.layers.Dense(1)\n",
        "    ])\n",
        "    return model\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 5. TRAIN AND EVALUATE BOTH MODELS\n",
        "# -------------------------------------------------\n",
        "models = {\n",
        "    \"SimpleRNN\": build_rnn(),\n",
        "    \"LSTM\": build_lstm()\n",
        "}\n",
        "\n",
        "results = {}\n",
        "histories = {}\n",
        "training_times = {}\n",
        "predictions = {}\n",
        "\n",
        "for name, model in models.items():\n",
        "\n",
        "    print(\"\\nTraining:\", name)\n",
        "\n",
        "    model.compile(\n",
        "        optimizer=\"adam\",\n",
        "        loss=\"mse\",\n",
        "        metrics=[\"mae\"]\n",
        "    )\n",
        "\n",
        "    start_time = time.time()\n",
        "\n",
        "    history = model.fit(\n",
        "        X_train, y_train,\n",
        "        validation_data=(X_val, y_val),\n",
        "        epochs=20,\n",
        "        batch_size=32,\n",
        "        verbose=0\n",
        "    )\n",
        "\n",
        "    elapsed = time.time() - start_time\n",
        "\n",
        "    histories[name] = history\n",
        "    training_times[name] = elapsed\n",
        "\n",
        "    # Prediction\n",
        "    pred = model.predict(X_test, verbose=0)\n",
        "\n",
        "    # Convert values to original scale\n",
        "    pred_original = scaler.inverse_transform(pred)\n",
        "    actual_original = scaler.inverse_transform(y_test)\n",
        "\n",
        "    predictions[name] = pred_original\n",
        "\n",
        "    # Metrics\n",
        "    mae = mean_absolute_error(actual_original, pred_original)\n",
        "    rmse = np.sqrt(mean_squared_error(actual_original, pred_original))\n",
        "    mape = np.mean(\n",
        "        np.abs((actual_original - pred_original) /\n",
        "               np.maximum(actual_original, 1))\n",
        "    ) * 100\n",
        "\n",
        "    results[name] = {\n",
        "        \"MAE\": mae,\n",
        "        \"RMSE\": rmse,\n",
        "        \"MAPE (%)\": mape,\n",
        "        \"Training Time (sec)\": elapsed\n",
        "    }\n",
        "\n",
        "    print(f\"{name} completed\")\n",
        "    print(\"MAE :\", round(mae, 2))\n",
        "    print(\"RMSE:\", round(rmse, 2))\n",
        "    print(\"MAPE:\", round(mape, 2), \"%\")\n",
        "    print(\"Training Time:\", round(elapsed, 2), \"seconds\")\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 6. TRAINING AND VALIDATION LOSS COMPARISON\n",
        "# -------------------------------------------------\n",
        "plt.figure(figsize=(10,5))\n",
        "\n",
        "for name, history in histories.items():\n",
        "\n",
        "    plt.plot(\n",
        "        history.history[\"loss\"],\n",
        "        label=f\"{name} Training Loss\"\n",
        "    )\n",
        "\n",
        "    plt.plot(\n",
        "        history.history[\"val_loss\"],\n",
        "        linestyle=\"--\",\n",
        "        label=f\"{name} Validation Loss\"\n",
        "    )\n",
        "\n",
        "plt.title(\"RNN vs LSTM Training and Validation Loss\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"MSE Loss\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 7. ACTUAL VS PREDICTED ORDERS\n",
        "# -------------------------------------------------\n",
        "actual = scaler.inverse_transform(y_test)\n",
        "\n",
        "plt.figure(figsize=(14,5))\n",
        "\n",
        "plt.plot(actual, label=\"Actual Orders\", linewidth=2)\n",
        "plt.plot(predictions[\"SimpleRNN\"], label=\"SimpleRNN Prediction\")\n",
        "plt.plot(predictions[\"LSTM\"], label=\"LSTM Prediction\")\n",
        "\n",
        "plt.title(\"Actual vs Predicted Daily Order Volume\")\n",
        "plt.xlabel(\"Test Day\")\n",
        "plt.ylabel(\"Number of Orders\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 8. MODEL PERFORMANCE COMPARISON\n",
        "# -------------------------------------------------\n",
        "results_df = pd.DataFrame(results).T\n",
        "\n",
        "print(\"\\nMODEL PERFORMANCE COMPARISON\")\n",
        "print(results_df.round(3))\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 9. METRIC COMPARISON GRAPH\n",
        "# -------------------------------------------------\n",
        "metrics = [\"MAE\", \"RMSE\", \"MAPE (%)\"]\n",
        "\n",
        "for metric in metrics:\n",
        "\n",
        "    plt.figure(figsize=(7,4))\n",
        "\n",
        "    plt.bar(\n",
        "        results_df.index,\n",
        "        results_df[metric]\n",
        "    )\n",
        "\n",
        "    plt.title(f\"Model Comparison - {metric}\")\n",
        "    plt.ylabel(metric)\n",
        "    plt.grid(axis=\"y\")\n",
        "    plt.show()\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 10. TRAINING TIME COMPARISON\n",
        "# -------------------------------------------------\n",
        "plt.figure(figsize=(7,4))\n",
        "\n",
        "plt.bar(\n",
        "    results_df.index,\n",
        "    results_df[\"Training Time (sec)\"]\n",
        ")\n",
        "\n",
        "plt.title(\"Training Time Comparison\")\n",
        "plt.ylabel(\"Seconds\")\n",
        "plt.grid(axis=\"y\")\n",
        "plt.show()\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 11. SAMPLE FORECAST TABLE\n",
        "# -------------------------------------------------\n",
        "forecast_table = pd.DataFrame({\n",
        "    \"Actual Orders\": actual.flatten(),\n",
        "    \"SimpleRNN\": predictions[\"SimpleRNN\"].flatten(),\n",
        "    \"LSTM\": predictions[\"LSTM\"].flatten()\n",
        "})\n",
        "\n",
        "print(\"\\nFORECAST SAMPLE:\")\n",
        "print(forecast_table.head(15).round(0))\n",
        "\n",
        "print(\"\\nEXPERIMENT 16 COMPLETED SUCCESSFULLY\")"
      ]
    }
