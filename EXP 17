        "# EXPERIMENT 17: RNN GRADIENT ANALYSIS AND GRADIENT CLIPPING\n",
        "# No Clipping vs clipnorm vs clipvalue\n",
        "\n",
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 1. CREATE CHARACTER-LEVEL TEXT CORPUS\n",
        "# -------------------------------------------------\n",
        "text = \"\"\"\n",
        "deep learning models learn patterns from data.\n",
        "recurrent neural networks process sequential information.\n",
        "gradient clipping helps stabilize training.\n",
        "machine learning improves prediction and analysis.\n",
        "\"\"\"\n",
        "\n",
        "text = text.lower() * 100\n",
        "\n",
        "chars = sorted(set(text))\n",
        "char_to_idx = {c:i for i,c in enumerate(chars)}\n",
        "idx_to_char = {i:c for c,i in char_to_idx.items()}\n",
        "\n",
        "encoded = np.array([char_to_idx[c] for c in text])\n",
        "\n",
        "SEQ_LENGTH = 40\n",
        "\n",
        "X, y = [], []\n",
        "\n",
        "for i in range(len(encoded) - SEQ_LENGTH):\n",
        "    X.append(encoded[i:i+SEQ_LENGTH])\n",
        "    y.append(encoded[i+SEQ_LENGTH])\n",
        "\n",
        "X = np.array(X)\n",
        "y = np.array(y)\n",
        "\n",
        "X = tf.convert_to_tensor(X, dtype=tf.int32)\n",
        "y = tf.convert_to_tensor(y, dtype=tf.int32)\n",
        "\n",
        "print(\"Corpus length:\", len(text))\n",
        "print(\"Vocabulary size:\", len(chars))\n",
        "print(\"Sequence samples:\", X.shape)\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 2. BUILD RNN MODEL\n",
        "# -------------------------------------------------\n",
        "def build_model():\n",
        "    model = tf.keras.Sequential([\n",
        "        tf.keras.layers.Embedding(len(chars), 32),\n",
        "        tf.keras.layers.SimpleRNN(64),\n",
        "        tf.keras.layers.Dense(len(chars))\n",
        "    ])\n",
        "    return model\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 3. CUSTOM TRAINING LOOP\n",
        "# -------------------------------------------------\n",
        "def train_model(setting, epochs=3, lr=0.05):\n",
        "\n",
        "    model = build_model()\n",
        "    optimizer = tf.keras.optimizers.SGD(learning_rate=lr)\n",
        "\n",
        "    loss_fn = tf.keras.losses.SparseCategoricalCrossentropy(\n",
        "        from_logits=True\n",
        "    )\n",
        "\n",
        "    grad_norms = []\n",
        "    losses = []\n",
        "\n",
        "    batch_size = 64\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "\n",
        "        indices = np.random.permutation(len(X))\n",
        "\n",
        "        for start in range(0, len(X), batch_size):\n",
        "\n",
        "            batch_indices = indices[start:start+batch_size]\n",
        "\n",
        "            xb = tf.gather(X, batch_indices)\n",
        "            yb = tf.gather(y, batch_indices)\n",
        "\n",
        "            with tf.GradientTape() as tape:\n",
        "\n",
        "                logits = model(xb, training=True)\n",
        "\n",
        "                loss = loss_fn(yb, logits)\n",
        "\n",
        "            grads = tape.gradient(\n",
        "                loss, model.trainable_variables\n",
        "            )\n",
        "\n",
        "            # Compute global gradient norm\n",
        "            global_norm = tf.linalg.global_norm(grads)\n",
        "\n",
        "            # Record gradient norm and loss\n",
        "            grad_norms.append(float(global_norm.numpy()))\n",
        "            losses.append(float(loss.numpy()))\n",
        "\n",
        "            # -------------------------------------------------\n",
        "            # GRADIENT CLIPPING\n",
        "            # -------------------------------------------------\n",
        "            if setting == \"ClipNorm_1.0\":\n",
        "\n",
        "                grads, _ = tf.clip_by_global_norm(\n",
        "                    grads, clip_norm=1.0\n",
        "                )\n",
        "\n",
        "            elif setting == \"ClipNorm_0.5\":\n",
        "\n",
        "                grads, _ = tf.clip_by_global_norm(\n",
        "                    grads, clip_norm=0.5\n",
        "                )\n",
        "\n",
        "            elif setting == \"ClipValue_0.5\":\n",
        "\n",
        "                grads = [\n",
        "                    tf.clip_by_value(g, -0.5, 0.5)\n",
        "                    for g in grads\n",
        "                ]\n",
        "\n",
        "            # Apply gradients\n",
        "            optimizer.apply_gradients(\n",
        "                zip(grads, model.trainable_variables)\n",
        "            )\n",
        "\n",
        "    return model, grad_norms, losses\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 4. TRAIN DIFFERENT CONFIGURATIONS\n",
        "# -------------------------------------------------\n",
        "settings = [\n",
        "    \"No_Clipping\",\n",
        "    \"ClipNorm_1.0\",\n",
        "    \"ClipNorm_0.5\",\n",
        "    \"ClipValue_0.5\"\n",
        "]\n",
        "\n",
        "results = {}\n",
        "\n",
        "for setting in settings:\n",
        "\n",
        "    print(\"\\nTraining configuration:\", setting)\n",
        "\n",
        "    model, grad_norms, losses = train_model(\n",
        "        setting,\n",
        "        epochs=3,\n",
        "        lr=0.05\n",
        "    )\n",
        "\n",
        "    results[setting] = {\n",
        "        \"model\": model,\n",
        "        \"grad_norms\": grad_norms,\n",
        "        \"losses\": losses\n",
        "    }\n",
        "\n",
        "    print(\"Steps:\", len(grad_norms))\n",
        "    print(\"Maximum gradient norm:\",\n",
        "          round(max(grad_norms), 4))\n",
        "    print(\"Final loss:\", round(losses[-1], 4))\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 5. GRADIENT NORM COMPARISON\n",
        "# -------------------------------------------------\n",
        "plt.figure(figsize=(12,5))\n",
        "\n",
        "for setting in settings:\n",
        "\n",
        "    norms = results[setting][\"grad_norms\"]\n",
        "\n",
        "    plt.plot(\n",
        "        norms,\n",
        "        label=setting,\n",
        "        alpha=0.8\n",
        "    )\n",
        "\n",
        "plt.title(\"Gradient Norm Comparison\")\n",
        "plt.xlabel(\"Training Step\")\n",
        "plt.ylabel(\"Global Gradient Norm\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 6. LOSS CURVE COMPARISON\n",
        "# -------------------------------------------------\n",
        "plt.figure(figsize=(12,5))\n",
        "\n",
        "for setting in settings:\n",
        "\n",
        "    losses = results[setting][\"losses\"]\n",
        "\n",
        "    plt.plot(\n",
        "        losses,\n",
        "        label=setting,\n",
        "        alpha=0.8\n",
        "    )\n",
        "\n",
        "plt.title(\"Training Loss Comparison\")\n",
        "plt.xlabel(\"Training Step\")\n",
        "plt.ylabel(\"Loss\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 7. GRADIENT SPIKE ANALYSIS\n",
        "# -------------------------------------------------\n",
        "print(\"\\nGRADIENT SPIKE ANALYSIS\")\n",
        "\n",
        "for setting in settings:\n",
        "\n",
        "    norms = np.array(results[setting][\"grad_norms\"])\n",
        "\n",
        "    threshold = np.mean(norms) + 2*np.std(norms)\n",
        "\n",
        "    spike_indices = np.where(norms > threshold)[0]\n",
        "\n",
        "    print(\"\\n\", setting)\n",
        "    print(\"Mean Gradient Norm:\", round(np.mean(norms),4))\n",
        "    print(\"Maximum Gradient Norm:\", round(np.max(norms),4))\n",
        "    print(\"Spike Threshold:\", round(threshold,4))\n",
        "    print(\"Spike Count:\", len(spike_indices))\n",
        "    print(\"Spike Steps:\", spike_indices[:15])\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 8. PERFORMANCE SUMMARY TABLE\n",
        "# -------------------------------------------------\n",
        "summary = []\n",
        "\n",
        "for setting in settings:\n",
        "\n",
        "    norms = results[setting][\"grad_norms\"]\n",
        "    losses = results[setting][\"losses\"]\n",
        "\n",
        "    summary.append({\n",
        "        \"Configuration\": setting,\n",
        "        \"Mean Gradient\": np.mean(norms),\n",
        "        \"Maximum Gradient\": np.max(norms),\n",
        "        \"Final Loss\": losses[-1],\n",
        "        \"Minimum Loss\": np.min(losses)\n",
        "    })\n",
        "\n",
        "summary_df = pd.DataFrame(summary)\n",
        "\n",
        "print(\"\\nFINAL COMPARISON TABLE\")\n",
        "print(summary_df.round(4).to_string(index=False))\n",
        "\n",
        "# -------------------------------------------------\n",
        "# 9. RECOMMEND CLIPPING THRESHOLD\n",
        "# -------------------------------------------------\n",
        "norm_1 = np.max(results[\"ClipNorm_1.0\"][\"grad_norms\"])\n",
        "norm_05 = np.max(results[\"ClipNorm_0.5\"][\"grad_norms\"])\n",
        "\n",
        "print(\"\\nCLIPPING RECOMMENDATION\")\n",
        "\n",
        "if norm_05 < norm_1:\n",
        "    print(\"ClipNorm 0.5 provides stronger gradient control.\")\n",
        "else:\n",
        "    print(\"ClipNorm 1.0 provides adequate gradient control.\")\n",
        "\n",
        "print(\"\\nEXPERIMENT 17 COMPLETED SUCCESSFULLY\")"
      ]
    }
